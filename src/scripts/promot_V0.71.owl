    <!-- http://purl.obolibrary.org/obo/HP_0031936 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0031936">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0002194"/>
        <obo:IAO_0000115>A failure to achieve the ability to walk at an appropriate developmental stage. Most children learn to walk in a series of stages, and learn to walk short distances independently between 12 and 15 months.</obo:IAO_0000115>
        <obo:PROMOT_1000001>Congenital myasthenic syndrom Scoping review</obo:PROMOT_1000001>
        <obo:PROMOT_1000001>Congenital myopathy HPO KB associations</obo:PROMOT_1000001>
        <obo:PROMOT_1000001>Congenital myopathy Scoping review</obo:PROMOT_1000001>
        <dcterms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <dcterms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-07-04T21:00:51Z</dcterms:date>
        <oboInOwl:hasExactSynonym>Delayed walking</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="fr">Delayed walking</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="es">Capacidad retrasada de caminar</rdfs:label>
        <rdfs:label>Delayed ability to walk</rdfs:label>
        <rdfs:label xml:lang="en">Delayed ability to walk </rdfs:label>
        <rdfs:label xml:lang="fr">Retard de la capacité à marcher</rdfs:label>
    </owl:Class>
    <owl:Axiom>
