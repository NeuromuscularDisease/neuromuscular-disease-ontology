    <!-- http://purl.obolibrary.org/obo/HP_0000486 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0000486">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0000549"/>
        <obo:IAO_0000115>A misalignment of the eyes so that the visual axes deviate from bifoveal fixation. The classification of strabismus may be based on a number of features including the relative position of the eyes, whether the deviation is latent or manifest, intermittent or constant, concomitant or otherwise and according to the age of onset and the relevance of any associated refractive error.</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="fr">Un défaut d&apos;alignement des yeux tel que les axes visuels s&apos;écartent de la fixation bifovéale. La classification du strabisme peut se fonder sur un certain nombre de caractéristiques, notamment la position relative des yeux, le caractère latent ou manifeste, intermittent ou constant, concomitant ou non, l&apos;âge d&apos;apparition et la pertinence de toute erreur de réfraction associée.</obo:IAO_0000115>
        <obo:PROMOT_1000001>Congenital myopathy HPO KB associations</obo:PROMOT_1000001>
        <oboInOwl:hasAlternativeId>HP:0000487</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>SNOMEDCT_US:128602000</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US:22066006</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0038379</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Cross-eyed</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="fr">Cross-eyed|Squint|Squint eyes</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Squint</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Squint eyes</oboInOwl:hasExactSynonym>
        <oboInOwl:id>HP:0000486</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/hp#hposlim_core"/>
        <rdfs:label xml:lang="es">Estrabismo</rdfs:label>
        <rdfs:label xml:lang="fr">Strabisme</rdfs:label>
        <rdfs:label>Strabismus</rdfs:label>
        <rdfs:label xml:lang="en">Strabismus</rdfs:label>
    </owl:Class>
