        <owl:annotatedTarget xml:lang="es">Alteración en la conducción nerviosa periférica</owl:annotatedTarget>
        <babelon:source_language>en</babelon:source_language>
        <babelon:source_value>Abnormality of peripheral nerve conduction</babelon:source_value>
