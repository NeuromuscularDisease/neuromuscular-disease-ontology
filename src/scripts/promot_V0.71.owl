    <!-- http://snomed.info/id/33821000087103 -->

    <owl:Class rdf:about="http://snomed.info/id/33821000087103">
        <rdfs:subClassOf rdf:resource="http://snomed.info/id/302147001"/>
        <sct-ext:definitionStatus>Primitif</sct-ext:definitionStatus>
        <sct-ext:fsn xml:lang="en">Gender identity (observable entity)</sct-ext:fsn>
        <dc11:type>observable entity</dc11:type>
        <rdfs:comment>[EURO-NMD] Atalia A et al., EURO-NMD registry: federated FAIR infrastructure, innovative technologies and concepts of a patient-centred registry for rare neuromuscular disorders. Orphanet J Rare Dis. 2024 Feb 14;19(1):66. doi: 10.1186/s13023-024-03059-3. PMID: 38355534; PMCID: PMC10865673.</rdfs:comment>
        <rdfs:comment>[PROMOT note] [Derived from RD-CDM] [2.4 Gender Identity] </rdfs:comment>
        <rdfs:comment>[RD-CDM] Graefe, A.S.L., Hübner, M.R., Rehburg, F. et al. An ontology-based rare disease common data model harmonising international registries, FHIR, and Phenopackets. Sci Data 12, 234 (2025). https://doi.org/10.1038/s41597-025-04558-z</rdfs:comment>
        <rdfs:label xml:lang="en">Gender identity</rdfs:label>
        <rdfs:label xml:lang="en">Gender identity (observable entity)</rdfs:label>
        <rdfs:label xml:lang="es">identidad de género (entidad observable)</rdfs:label>
        <skos:definition xml:lang="en">Gender identity is an individual&apos;s personal sense of being a male gender (man, boy), female gender (woman, girl), another gender(s), or no gender, that is not necessarily visible to others and must be declared by the person.</skos:definition>
        <skos:definition xml:lang="es">La identidad de género es la autopercepción personal e individual como género masculino (hombre, chico), género femenino (mujer, chica), otro género/s, o ninguno de ellos; no es necesariamente visible para otros y debe ser declarada por la propia persona.</skos:definition>
        <skos:notation>33821000087103</skos:notation>
        <skos:prefLabel xml:lang="en">Gender identity</skos:prefLabel>
        <skos:prefLabel xml:lang="es">identidad de género</skos:prefLabel>
    </owl:Class>
    


