    <!-- http://purl.obolibrary.org/obo/HP_0001260 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0001260">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0002167"/>
        <obo:IAO_0000115>Dysarthric speech is a general description referring to a neurological speech disorder characterized by poor articulation. Depending on the involved neurological structures, dysarthria may be further classified as spastic, flaccid, ataxic, hyperkinetic and hypokinetic, or mixed.</obo:IAO_0000115>
