        <efo:alternative_term xml:lang="en">CMS</efo:alternative_term>
        <efo:definition xml:lang="en">Congenital myasthenic syndrome (CMS) is a group of genetic disorders of impaired neuromuscular transmission at the motor endplate characterized by fatigable muscle weakness.</efo:definition>
        <efo:definition_citation xml:lang="en">Orphanet</efo:definition_citation>
