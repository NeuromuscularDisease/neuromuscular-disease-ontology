                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/PROMOT_2000002"/>
                <owl:someValuesFrom rdf:resource="http://id.who.int/icd/entity/1360101629"/>
            </owl:Restriction>
        </rdfs:subClassOf>
