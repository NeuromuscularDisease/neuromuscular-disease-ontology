    <!-- http://id.who.int/icd/entity/1019379329 -->

    <owl:Class rdf:about="http://id.who.int/icd/entity/1019379329">
        <rdfs:subClassOf rdf:resource="http://id.who.int/icd/entity/644658903"/>
        <schema:browserUrl rdf:resource="https://icd.who.int/dev11/f/en#/http%3A%2F%2Fid.who.int%2Ficd%2Fentity%2F1019379329"/>
        <rdfs:label xml:lang="es">Estructura de la extremidad superior</rdfs:label>
