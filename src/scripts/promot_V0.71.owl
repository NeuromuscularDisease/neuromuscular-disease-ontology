    <!-- http://purl.obolibrary.org/obo/HP_0011727 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0011727">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0009053"/>
        <obo:IAO_0000115>Weakness of the peroneal muscles.</obo:IAO_0000115>
        <obo:PROMOT_1000001>Congenital myasthenic syndrom Scoping review</obo:PROMOT_1000001>
        <obo:PROMOT_1000001>Congenital myopathy Scoping review</obo:PROMOT_1000001>
