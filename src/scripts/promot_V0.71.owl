        <oboInOwl:hasExactSynonym xml:lang="fr">affections psychiatriques</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="fr">affections psychiatriques|troubles psychiatriques</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="fr">troubles psychiatriques</oboInOwl:hasExactSynonym>
        <oboInOwl:id>HP:0000708</oboInOwl:id>
        <rdfs:comment>Atypical behaviors should include or directly affect observable actions. While behavioral disorders often encompass abnormal thoughts, feelings, perceptions, or other cognitions, these alone would not be considered atypical behavioral features.</rdfs:comment>
        <rdfs:label xml:lang="es">Alteración comportamental</rdfs:label>
        <rdfs:label>Atypical behavior</rdfs:label>
        <rdfs:label xml:lang="fr">Troubles psychiatriques ou comportementaux</rdfs:label>
    </owl:Class>
