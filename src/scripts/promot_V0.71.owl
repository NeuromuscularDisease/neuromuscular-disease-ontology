    <!-- http://purl.obolibrary.org/obo/HP_0000007 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0000007">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0034345"/>
        <obo:IAO_0000115>A mode of inheritance that is observed for traits related to a gene encoded on one of the autosomes (i.e., the human chromosomes 1-22) in which a trait manifests in individuals with two pathogenic alleles, either homozygotes (two copies of the same mutant allele) or compound heterozygotes (whereby each copy of a gene has a distinct mutant allele).</obo:IAO_0000115>
        <obo:IAO_0000115 xml:lang="fr">Un mode de transmission qui concerne les caractères associés à un gène porté par un autosome (c.-à-d., les chromosomes 1 à 22 chez l&apos;être humain), et où le caractère se manifeste chez les porteurs homozygotes. Dans le cadre de la génétique médicale, une maladie autosomique récessive se manifeste chez les porteurs homozygotes (présence de deux allèles mutés identiques) ou chez les hétérozygotes composites (présence de deux allèles mutés différents)</obo:IAO_0000115>
        <obo:PROMOT_1000001>Congenital myasthenic syndrom HPO DB associations</obo:PROMOT_1000001>
        <obo:PROMOT_1000001>Congenital myopathy HPO KB associations</obo:PROMOT_1000001>
        <obo:PROMOT_1000001>Oculopharyngeal muscular dystrophy Medical expert https://orcid.org/0000-0003-2829-8470</obo:PROMOT_1000001>
        <oboInOwl:hasAlternativeId>HP:0001416</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>HP:0001526</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>HP:0031362</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>SNOMEDCT_US:258211005</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0441748</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C4020899</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Autosomal recessive</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="fr">Autosomique récessif</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="fr">Forme autosomique récessive</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>biallelic_autosomal</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>Autosomal recessive form</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Autosomal recessive predisposition</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>HP:0000007</oboInOwl:id>
        <rdfs:comment>[EURO-NMD] Atalia A et al., EURO-NMD registry: federated FAIR infrastructure, innovative technologies and concepts of a patient-centred registry for rare neuromuscular disorders. Orphanet J Rare Dis. 2024 Feb 14;19(1):66. doi: 10.1186/s13023-024-03059-3. PMID: 38355534; PMCID: PMC10865673.</rdfs:comment>
        <rdfs:comment>[PROMOT note] [Derived from EURO-NMD] </rdfs:comment>
        <rdfs:label>Autosomal recessive inheritance</rdfs:label>
        <rdfs:label xml:lang="en">Autosomal recessive inheritance</rdfs:label>
        <rdfs:label xml:lang="es">Herencia autosómica recesiva</rdfs:label>
        <rdfs:label xml:lang="fr">Transmission autosomique récessive</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000007"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A mode of inheritance that is observed for traits related to a gene encoded on one of the autosomes (i.e., the human chromosomes 1-22) in which a trait manifests in individuals with two pathogenic alleles, either homozygotes (two copies of the same mutant allele) or compound heterozygotes (whereby each copy of a gene has a distinct mutant allele).</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
