    <!-- http://purl.obolibrary.org/obo/HP_0033666 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0033666">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0033665"/>
        <obo:IAO_0000115>A reduction in the ability to perform activities of daily living as compared to previous abilities because of functional deficits due to illness. The 36-item Short Form (SF-36) health survey questionnaire is one of many methods used to measure patients&apos; perceptions of diminished physical functioning.</obo:IAO_0000115>
        <dcterms:creator rdf:resource="https://orcid.org/0000-0002-0736-9199"/>
        <dcterms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-02-28T14:50:02Z</dcterms:date>
        <oboInOwl:hasExactSynonym>Decline in physical functional health</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Diminished physical health</oboInOwl:hasExactSynonym>
        <rdfs:label>Diminished physical functioning</rdfs:label>
