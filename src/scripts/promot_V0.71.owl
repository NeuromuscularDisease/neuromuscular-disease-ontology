        <fma:non-English_equivalent>Struttura anatomica</fma:non-English_equivalent>
        <fma:preferred_name>Anatomical structure</fma:preferred_name>
        <fma:synonym>Biological structure</fma:synonym>
        <rdfs:label xml:lang="en">Anatomical structure</rdfs:label>
