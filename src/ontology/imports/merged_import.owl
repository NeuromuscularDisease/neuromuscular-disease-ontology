AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MONDO_0017629> "MONDO:0017629")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0017629> "obsolete sodium channelopathy-related small fiber neuropathy")
AnnotationAssertion(owl:deprecated <http://purl.obolibrary.org/obo/MONDO_0017629> "true"^^xsd:boolean)
