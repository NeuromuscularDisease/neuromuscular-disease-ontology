AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <https://www.genenames.org/data/genegroup/#!/group/3641> "DNA replication factor C")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/OMO_0003000>) <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <https://www.genenames.org/data/genegroup/#!/group/3641> "RFC")
AnnotationAssertion(rdfs:label <https://www.genenames.org/data/genegroup/#!/group/3641> "Replication factor C")
SubClassOf(<https://www.genenames.org/data/genegroup/#!/group/3641> <http://purl.obolibrary.org/obo/SO_0005855>)

