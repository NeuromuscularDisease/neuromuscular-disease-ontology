EquivalentClasses(Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "https://clinicalgenome.org/affiliation/40031/") <http://purl.obolibrary.org/obo/MONDO_0100150> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/MONDO_0019952> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0004003> <http://identifiers.org/hgnc/10483>)))
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0100150> <http://purl.obolibrary.org/obo/MONDO_0002320>)
SubClassOf(Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "Orphanet:98742") Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "https://orcid.org/0000-0001-5208-3432") <http://purl.obolibrary.org/obo/MONDO_0100150> <http://purl.obolibrary.org/obo/MONDO_0019119>)
