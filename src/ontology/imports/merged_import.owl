# Class: <http://purl.obolibrary.org/obo/MONDO_0100061> (PRPS1 deficiency disorder)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:17701900") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:20021999") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:25182139") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:25491489") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:25785835") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:27256512") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:27886419") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0100061> "A peripheral neuropathy that is characterized by variants in PRPS1, which causes decreased or impaired function of the PRPS1 enzyme, and presents as a range of peripheral neuropathies that can include features of Charcot-Marie Tooth syndrome, Arts syndrome, or nonsyndromic hearing loss.")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "MONDO:GARD") <http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/MONDO_0100061> "GARD:0026031")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MONDO_0100061> "PRPS1-related CMTX5/Arts syndrome/XLNSHL")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MONDO_0100061> "MONDO:0100061")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/MONDO_0100061> "Individuals, both male and female, have been reported with familial missense variants in the PRPS1 gene. These patients have been described in the literature as having a range of phenotypes characterized as Arts syndrome, Charcot Marie Tooth syndrome, and non-syndromic hearing loss segregating in an X-linked pattern. Severity and presence of phenotypes makes it difficult to separate the non-syndromic and syndromic forms of hearing loss disorders associated with this gene.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0100061> "PRPS1 deficiency disorder")
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_0100061> <http://purl.obolibrary.org/obo/MONDO_0020127>)
SubClassOf(Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "PMID:17701900") Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "PMID:20021999") Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "PMID:25182139") Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "PMID:25491489") Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "PMID:25785835") Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "PMID:27256512") Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "PMID:27886419") <http://purl.obolibrary.org/obo/MONDO_0100061> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0004003> <http://identifiers.org/hgnc/9462>))
SubClassOf(Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "https://orcid.org/0000-0001-5208-3432") <http://purl.obolibrary.org/obo/MONDO_0100061> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0004029> <http://purl.obolibrary.org/obo/MONDO_0010533>))
SubClassOf(Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "MONDO:agrant9394") <http://purl.obolibrary.org/obo/MONDO_0100061> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0004029> <http://purl.obolibrary.org/obo/MONDO_0015626>))
SubClassOf(Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "MONDO:agrant9394") <http://purl.obolibrary.org/obo/MONDO_0100061> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0004029> <http://purl.obolibrary.org/obo/MONDO_0019497>))

# Class: <http://purl.obolibrary.org/obo/MONDO_0100062> (genetic developmental and epileptic encephalopathy)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:28276062") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0100062> "A complex neurodevelopmental disorder characterized by a range of developmental delays and epileptic encephalopathy phenotypes. Seizure onset is variable and intellectual disability is variable in presence and severity.")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://orcid.org/0000-0001-8486-0558") <http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym> <http://purl.obolibrary.org/obo/MONDO_0100062> "developmental and epileptic encephalopathy")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "MONDO:equivalentTo") <http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/MONDO_0100062> "DOID:0112202")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "MONDO:GARD") <http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/MONDO_0100062> "GARD:0009255")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "MONDO:i2s") Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "MONDO:relatedTo") <http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/MONDO_0100062> "ICD9:345.10")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "MONDO:NANDO") Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "https://orcid.org/0000-0002-0170-9172") Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "https://orcid.org/0000-0003-0011-764X") <http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/MONDO_0100062> "NANDO:1200593")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "MONDO:equivalentTo") <http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/MONDO_0100062> "NCIT:C122814")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "MONDO:equivalentTo") Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "MONDO:pnr") <http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/MONDO_0100062> "OMIMPS:308350")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://orcid.org/0000-0001-5208-3432") <http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym> <http://purl.obolibrary.org/obo/MONDO_0100062> "hereditary developmental and epileptic encephalopathy")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MONDO_0100062> "MONDO:0100062")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/MONDO_0100062> "Individuals, both male and female, have been reported with variants in the GABRB3 gene. De novo and familial cases have been reported, with mostly missense and a few nonsense variants identified as causative. These patients have been described in the literature as having a range of phenotypes characterized as epileptic encephalopathy, Lennox-Gastaut syndrome, Dravet syndrome-like, and childhood absence epilepsy. Severity of intellectual disability is variable among reported probands, as is the age of onset of seizure phenotypes. In one case of epileptic encephalopathy, for example, the individual presented with severe intellectual disability while seizures onset at 12 years old. Additionally, individuals have been reported with the same de novo missense variants, and have been described with varying phenotypes. (PMID:26544041, PMID:26704558, PMID:26645412, PMID:26993267, PMID:27476654)")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_0100062> "genetic developmental and epileptic encephalopathy")
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#exactMatch> <http://purl.obolibrary.org/obo/MONDO_0100062> <http://purl.obolibrary.org/obo/DOID_0112202>)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#exactMatch> <http://purl.obolibrary.org/obo/MONDO_0100062> <http://purl.obolibrary.org/obo/NCIT_C122814>)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#exactMatch> <http://purl.obolibrary.org/obo/MONDO_0100062> <https://omim.org/phenotypicSeries/PS308350>)
EquivalentClasses(<http://purl.obolibrary.org/obo/MONDO_0100062> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/MONDO_0100620> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000053> <http://purl.obolibrary.org/obo/MONDO_0021152>)))
