# Class: <http://purl.obolibrary.org/obo/MONDO_0018011> (juvenile overlap myositis)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "Orphanet:329894") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0018011> "Juvenile overlap myositis is a rare juvenile idiopathic inflammatory myopathy characterized by the association of inflammatory myositis (manifesting with acral erythema, progressive weakness of the limbs, pain, general fatigue, moodiness or crankiness) with clinical and/or laboratory features of other autoimmune diseases (e.g. systemic lupus erythematosus, localized scleroderma, diabetes). Cardiac involvement has been reported in some patients.")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "MONDO:GARD") <http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/MONDO_0018011> "GARD:0021497")
