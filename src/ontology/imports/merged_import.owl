AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/OMO_0003000>) <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <https://www.genenames.org/data/genegroup/#!/group/732> "SEPTIN")
AnnotationAssertion(rdfs:label <https://www.genenames.org/data/genegroup/#!/group/732> "Septins")
