AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/NCIT_P383> "PT") Annotation(<http://purl.obolibrary.org/obo/NCIT_P384> "NCI") <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/NCIT_C115791> "Nine-Hole Peg Functional Test")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/NCIT_C115791> "Nine-Hole Peg Functional Test")
