AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/hp#uk_spelling>) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0025270> "Functional abnormality of the oesophagus")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0025270> "Abnormal esophagus physiology")
