# Class: <http://purl.obolibrary.org/obo/NCIT_C115791> (Nine-Hole Peg Functional Test)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/NCIT_P378> "NCI") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/NCIT_C115791> "A standardized rating scale developed by Mathiowetz et al in 1985 to measure unilateral finger dexterity to determine the extent of fine motor impairment in people experiencing difficulties with functional performance. This functional test requires the use of both dominant and non-dominant hands, and assesses fine motor and hand/eye coordination, as well as ability to follow simple directions. Scoring of this test is based on the average of 4 trials.")
AnnotationAssertion(<http://purl.obolibrary.org/obo/NCIT_P207> <http://purl.obolibrary.org/obo/NCIT_C115791> "C3891812")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/NCIT_P383> "PT") Annotation(<http://purl.obolibrary.org/obo/NCIT_P383> "SY") Annotation(<http://purl.obolibrary.org/obo/NCIT_P384> "CDISC") Annotation(<http://purl.obolibrary.org/obo/NCIT_P384> "NCI") <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/NCIT_C115791> "NHPT")
