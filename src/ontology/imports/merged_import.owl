SubClassOf(<https://www.genenames.org/data/genegroup/#!/group/436> <https://www.genenames.org/data/genegroup/#!/group/424>)

# Class: <https://www.genenames.org/data/genegroup/#!/group/437> (Glycogen phosphorylases)

AnnotationAssertion(<http://purl.org/dc/terms/description> <https://www.genenames.org/data/genegroup/#!/group/437> "Glycogen phosphorylase is one of the phosphorylase enzymes ( EC 2.4.1.1 ). Glycogen phosphorylase catalyzes the rate-limiting step in glycogenolysis in animals by releasing glucose-1-phosphate from the terminal alpha-1,4-glycosidic bond. Glycogen phosphorylase is also studied as a model protein regulated by both reversible phosphorylation and allosteric effects.")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/OMO_0003000>) <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <https://www.genenames.org/data/genegroup/#!/group/437> "PYG")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <https://www.genenames.org/data/genegroup/#!/group/437> "Phosphorylases, glycogen")
AnnotationAssertion(rdfs:label <https://www.genenames.org/data/genegroup/#!/group/437> "Glycogen phosphorylases")
SubClassOf(<https://www.genenames.org/data/genegroup/#!/group/437> <https://www.genenames.org/data/genegroup/#!/group/424>)

# Class: <https://www.genenames.org/data/genegroup/#!/group/443> (Glycosyltransferase family 90)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/OMO_0003000>) <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <https://www.genenames.org/data/genegroup/#!/group/443> "POGLUT")
AnnotationAssertion(rdfs:label <https://www.genenames.org/data/genegroup/#!/group/443> "Glycosyltransferase family 90")
