AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/HP_0010535> "Sleep apnoea")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/HP_0010535> "HP:0010535")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0010535> "Sleep apnea")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0010535> <http://purl.obolibrary.org/obo/HP_0011446>)

