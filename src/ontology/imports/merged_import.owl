AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/UBERON_0006283> "embryonic heart ventricle")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/UBERON_0006283> "future heart ventricle")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "ZFA:0001719") <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/UBERON_0006283> "presumptive cardiac ventricle heart tube")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "EHDAA2:0001531") <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/UBERON_0006283> "primitive ventricle")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "EMAPA:16350") <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/UBERON_0006283> "primitive ventricle of heart")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FMA:71006") <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/UBERON_0006283> "primordial cardiac ventricle")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FMA:71006") <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/UBERON_0006283> "primordial ventricle")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/UBERON_0006283> "UBERON:0006283")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/UBERON_0006283> "The embryonic ventricle or primitive ventricle of the developing heart gives rise to the trabeculated parts of the left and right ventricles. In contrast, the smooth parts of the left and right ventricles originate from the embryological bulbus cordis. The primitive ventricle becomes divided by a septum, the septum inferius or ventricular septum, which grows upward from the lower part of the ventricle, its position being indicated on the surface of the heart by a furrow. Its dorsal part increases more rapidly than its ventral portion, and fuses with the dorsal part of the septum intermedium. For a time an interventricular foramen exists above its ventral portion, but this foramen is ultimately closed by the fusion of the aortic septum with the ventricular septum[WP]")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/UBERON_0006283> "future cardiac ventricle")
SubClassOf(<http://purl.obolibrary.org/obo/UBERON_0006283> <http://purl.obolibrary.org/obo/UBERON_0006598>)
