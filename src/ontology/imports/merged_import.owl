AnnotationAssertion(rdfs:label <https://www.genenames.org/data/genegroup/#!/group/544> "Exonucleases")
SubClassOf(<https://www.genenames.org/data/genegroup/#!/group/544> <http://purl.obolibrary.org/obo/SO_0005855>)

