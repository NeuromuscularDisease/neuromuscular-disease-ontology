AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/NCIT_P383> "PT") Annotation(<http://purl.obolibrary.org/obo/NCIT_P383> "SY") Annotation(<http://purl.obolibrary.org/obo/NCIT_P384> "CDISC") Annotation(<http://purl.obolibrary.org/obo/NCIT_P384> "NCI") <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/NCIT_C115795> "TUG")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/NCIT_P383> "SY") Annotation(<http://purl.obolibrary.org/obo/NCIT_P384> "CDISC") <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/NCIT_C115795> "TUG01")
