AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <https://www.genenames.org/data/genegroup/#!/group/2259> "p97-Nploc4 ATPase complex")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <https://www.genenames.org/data/genegroup/#!/group/2259> "p97-UFD1-NPL4 unfoldase")
AnnotationAssertion(rdfs:label <https://www.genenames.org/data/genegroup/#!/group/2259> "VCP-Ufd1-Npl4 complex subunits")
SubClassOf(<https://www.genenames.org/data/genegroup/#!/group/2259> <http://purl.obolibrary.org/obo/SO_0005855>)

