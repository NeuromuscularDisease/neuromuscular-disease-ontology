# Class: <http://purl.obolibrary.org/obo/MONDO_0016578> (obsolete mitochondrial oxidative phosphorylation disorder due to nuclear DNA anomalies)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "Orphanet:2443") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_0016578> "OBSOLETE. Mitochondrial oxidative phosphorylation disorder due to nuclear DNA anomalies is a group of clinically heterogeneous diseases, commonly defined by lack of cellular energy due to defects of oxidative phosphorylation (OXPHOS), resulting from pathogenic mutations in the nuclear DNA. Mitochondrial oxidative phosphorylation disorder due to nuclear DNA anomalies includes diseases classified according to defects in: genes encoding structural components of OXPHOS complexes (such as Leigh syndrome, coenzyme Q10 deficiency); genes encoding assembly factors of OXPHOS complexes (such as GRACILE syndrome); genes altering the stability of mitochondrial DNA (such as autosomal dominant progressive external ophthalmoplegia, mitochondrial DNA depletion syndrome); mitochondrial protein synthesis.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#consider> <http://purl.obolibrary.org/obo/MONDO_0016578> <http://purl.obolibrary.org/obo/MONDO_0016387>)
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "MONDO:obsoleteEquivalent") <http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/MONDO_0016578> "Orphanet:2443")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MONDO_0016578> "OXPHOS disease due to nDNA anomalies")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MONDO_0016578> "OXPHOS disease due to nuclear DNA anomalies")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/MONDO_0016578> "mitochondrial oxidative phosphorylation disorder due to nDNA anomalies")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MONDO_0016578> "MONDO:0016578")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/MONDO_0016578> "Reason: out of scope. This is an Orphanet grouping class that is considered out of scope for Mondo. Term to consider: mitochondrial oxidative phosphorylation disorder'")
