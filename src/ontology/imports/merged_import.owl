SubClassOf(<http://purl.obolibrary.org/obo/UBERON_0004209> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002202> <http://purl.obolibrary.org/obo/UBERON_0004208>))
SubClassOf(<http://purl.obolibrary.org/obo/UBERON_0004209> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002387> <http://purl.obolibrary.org/obo/UBERON_0004211>))

