AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MONDO_1060232> "MONDO:1060232")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_1060232> "congenital insensitivity to pain")
SubClassOf(Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "https://orcid.org/0000-0001-9310-0163") Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "https://orcid.org/0000-0002-7638-4659") Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "https://rarediseases.org/rare-diseases/congenital-insensitivity-to-pain-cip/") <http://purl.obolibrary.org/obo/MONDO_1060232> <http://purl.obolibrary.org/obo/MONDO_0015364>)

