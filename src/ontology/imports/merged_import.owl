# Class: <http://purl.obolibrary.org/obo/MONDO_1040012> (PI4KA-related disorder)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:35951779") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.clinicalgenome.org/affiliation/40020/") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MONDO_1040012> "Any human disease in which the cause of the disease is a variation in the PI4KA gene. This disease is characterized primarily by neurologic dysfunction (limb spasticity, developmental delay, intellectual disability, seizures, ataxia, nystagmus), gastrointestinal manifestations (multiple intestinal atresia, inflammatory bowel disease), and combined immunodeficiency (leukopenia, variable immunoglobulin defects). Age of onset is typically antenatal or in early childhood; individuals can present with any combination of these features. Rare individuals present with later-onset hereditary spastic paraplegia. Brain MRI findings can include hypomyelinating leukodystrophy, cerebellar hypoplasia/atrophy, thin or dysplastic corpus callosum, and/or perisylvian polymicrogyria.")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "MONDO:GARD") <http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/MONDO_1040012> "GARD:0027233")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/MONDO_1040012> "MONDO:1040012")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MONDO_1040012> "PI4KA-related disorder")
EquivalentClasses(<http://purl.obolibrary.org/obo/MONDO_1040012> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/MONDO_0700096> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0004003> <http://identifiers.org/hgnc/8983>)))
SubClassOf(Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "PMID:35951779") Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "https://orcid.org/0000-0002-5002-8648") <http://purl.obolibrary.org/obo/MONDO_1040012> <http://purl.obolibrary.org/obo/MONDO_0003847>)
SubClassOf(<http://purl.obolibrary.org/obo/MONDO_1040012> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0004003> <http://identifiers.org/hgnc/8983>))

