AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <https://www.genenames.org/data/genegroup/#!/group/861> "BR-C, ttk and bab domain containing")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <https://www.genenames.org/data/genegroup/#!/group/861> "BTB (POZ) domain containing")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/OMO_0003000>) <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <https://www.genenames.org/data/genegroup/#!/group/861> "BTBD")
AnnotationAssertion(rdfs:label <https://www.genenames.org/data/genegroup/#!/group/861> "BTB domain containing")
