AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "MEDGEN:1800807") Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "MONDO:MEDGEN") Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "MONDO:equivalentTo") <http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/MONDO_0100464> "UMLS:C5243927")
