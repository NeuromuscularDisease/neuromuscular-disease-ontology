# Class: obo:NCIT_C115789 (6 Minute Walk Functional Test)

AnnotationAssertion(Annotation(obo:NCIT_P378 "NCI") obo:IAO_0000115 obo:NCIT_C115789 "A standardized rating scale developed by Bruno Blake in 1963, which is a performance-based evaluation of functional exercise capacity in subjects with chronic respiratory disease and heart failure, as well as other populations such as healthy older adults and people suffering from fibromyalgia and scleroderma. This functional test contains 6 items and measures the distance an individual is able to walk over a total of six minutes on a hard, flat surface.")
AnnotationAssertion(obo:NCIT_P207 obo:NCIT_C115789 "C3900196")
AnnotationAssertion(Annotation(obo:NCIT_P383 "DN") Annotation(obo:NCIT_P383 "PT") Annotation(obo:NCIT_P384 "CTRP") Annotation(obo:NCIT_P384 "NCI") oboInOwl:hasExactSynonym obo:NCIT_C115789 "6 Minute Walk Functional Test")
AnnotationAssertion(Annotation(obo:NCIT_P383 "SY") Annotation(obo:NCIT_P384 "NCI") oboInOwl:hasExactSynonym obo:NCIT_C115789 "6MWT")
AnnotationAssertion(Annotation(obo:NCIT_P383 "PT") Annotation(obo:NCIT_P384 "CDISC") oboInOwl:hasExactSynonym obo:NCIT_C115789 "SIX MINUTE WALK")
AnnotationAssertion(Annotation(obo:NCIT_P383 "SY") Annotation(obo:NCIT_P384 "CDISC") oboInOwl:hasExactSynonym obo:NCIT_C115789 "SIXMW1")
AnnotationAssertion(rdfs:label obo:NCIT_C115789 "6 Minute Walk Functional Test")
SubClassOf(obo:NCIT_C115789 obo:NCIT_C222260)

# Class: obo:NCIT_C115791 (Nine-Hole Peg Functional Test)

AnnotationAssertion(Annotation(obo:NCIT_P378 "NCI") obo:IAO_0000115 obo:NCIT_C115791 "A standardized rating scale developed by Mathiowetz et al in 1985 to measure unilateral finger dexterity to determine the extent of fine motor impairment in people experiencing difficulties with functional performance. This functional test requires the use of both dominant and non-dominant hands, and assesses fine motor and hand/eye coordination, as well as ability to follow simple directions. Scoring of this test is based on the average of 4 trials.")
AnnotationAssertion(Annotation(oboInOwl:source "http://purl.obolibrary.org/obo/PROMOT_0100016") obo:IAO_0000115 obo:NCIT_C115791 "Test measuring the grip force allows quantifying the maximum voluntary force of the muscles of the hand and forearm, during a finger flexion action. This is an indicator of the level of hand function.")
AnnotationAssertion(obo:NCIT_P207 obo:NCIT_C115791 "C3891812")
AnnotationAssertion(oboInOwl:hasDbXref obo:NCIT_C115791 "http://purl.obolibrary.org/obo/PROMOT_0100016")
AnnotationAssertion(Annotation(obo:NCIT_P383 "PT") Annotation(obo:NCIT_P383 "SY") Annotation(obo:NCIT_P384 "CDISC") Annotation(obo:NCIT_P384 "NCI") oboInOwl:hasExactSynonym obo:NCIT_C115791 "NHPT")
AnnotationAssertion(Annotation(obo:NCIT_P383 "SY") Annotation(obo:NCIT_P384 "CDISC") oboInOwl:hasExactSynonym obo:NCIT_C115791 "NHPT01")
AnnotationAssertion(Annotation(obo:NCIT_P383 "PT") Annotation(obo:NCIT_P384 "NCI") oboInOwl:hasExactSynonym obo:NCIT_C115791 "Nine-Hole Peg Functional Test")
AnnotationAssertion(rdfs:comment obo:NCIT_C115791 "PROMOT mapping: 'Assessment using Hand Jamar dynanometer' (LLM score: 0.4297) | Candidates: Nine-Hole Peg Functional Test [0.43] | Quantitative Muscle Testing [0.402] | Manual Muscle Testing [0.386]")
AnnotationAssertion(rdfs:label obo:NCIT_C115791 "Nine-Hole Peg Functional Test")
