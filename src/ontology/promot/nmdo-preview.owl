# Class: obo:UBERON_0011823 (dense connective tissue)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "Wikipedia:Dense_connective_tissue") obo:IAO_0000115 obo:UBERON_0011823 "Dense connective tissue is mainly composed of collagen type I. Crowded between the collagen fibers are rows of fibroblasts, fiber-forming cells, that manufacture the fibers. Dense connective tissue forms strong, rope-like structures such as tendons and ligaments. Tendons attach skeletal muscles to bones; ligaments connect bones to bones at joints. Ligaments are more stretchy and contain more elastic fibers than tendons. Dense connective tissue also make up the lower layers of the skin (dermis), where it is arranged in sheets.")
AnnotationAssertion(obo:IAO_0000116 obo:UBERON_0011823 "our OWL definition states that this is differentiated from other connective tissue types by virtue of the fact that the collage fiber component predominates, as opposed to cells and fluid.")
AnnotationAssertion(oboInOwl:hasDbXref obo:UBERON_0011823 "AAO:0000121")
AnnotationAssertion(oboInOwl:hasDbXref obo:UBERON_0011823 "NCIT:C32450")
AnnotationAssertion(Annotation(oboInOwl:source "ncithesaurus:Dense_Connective_Tissue") oboInOwl:hasDbXref obo:UBERON_0011823 "UMLS:C1511770")
AnnotationAssertion(oboInOwl:hasDbXref obo:UBERON_0011823 "Wikipedia:Dense_connective_tissue")
AnnotationAssertion(oboInOwl:id obo:UBERON_0011823 "UBERON:0011823")
AnnotationAssertion(rdfs:label obo:UBERON_0011823 "dense connective tissue")
EquivalentClasses(obo:UBERON_0011823 ObjectIntersectionOf(obo:UBERON_0002384 ObjectSomeValuesFrom(obo:RO_0002473 obo:UBERON_0011860)))
SubClassOf(obo:UBERON_0011823 obo:UBERON_0002384)
SubClassOf(obo:UBERON_0011823 ObjectSomeValuesFrom(obo:RO_0002473 obo:UBERON_0011860))
DisjointClasses(obo:UBERON_0011823 obo:UBERON_0011825)

