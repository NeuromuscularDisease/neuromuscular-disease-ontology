AnnotationAssertion(Annotation(oboInOwl:hasSynonymType hp:layperson) oboInOwl:hasExactSynonym obo:HP_0003236 "Increased serum creatine phosphokinase")
AnnotationAssertion(oboInOwl:id obo:HP_0003236 "HP:0003236")
AnnotationAssertion(rdfs:comment obo:HP_0003236 "Elevated serum creatine kinase (CK) activity is usually an indicator of muscle damage. Diseases with very high CK values include subtypes of muscular dystrophies, idiopathic inflammatory myopathies and metabolic myopathies. However, a normal or only slightly elevated CK value does not exclude the presence of a myopathy. The normal range in the blood circulation is 34-171 U/l in males and 34-145 U/l in females, but may vary according to the test used.")
AnnotationAssertion(rdfs:label obo:HP_0003236 "Elevated circulating creatine kinase concentration")
SubClassOf(obo:HP_0003236 obo:HP_0010876)

