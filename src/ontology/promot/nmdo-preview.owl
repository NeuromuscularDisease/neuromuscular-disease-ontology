# Class: obo:MONDO_0100464 (acid sphingomyelinase deficiency)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PMID:20301544") Annotation(oboInOwl:hasDbXref "PMID:28406489") Annotation(oboInOwl:hasDbXref "PMID:34654332") Annotation(oboInOwl:hasDbXref "https://clinicalgenome.org/affiliation/40110/") obo:IAO_0000115 obo:MONDO_0100464 "An autosomal recessive lysosomal disease caused by biallelic loss of function variants in the SMPD1 gene. Clinical symptoms in affected individuals occur along a continuum. At the severe end of the spectrum are individuals historically diagnosed with Niemann-Pick disease type A (the neurovisceral form), which is characterized by hepatosplenomegaly with rapid neurological deterioration leading to death in the first few years of life. At the milder end of the spectrum are individuals historically diagnosed with Niemann-Pick disease type B, a later-onset, chronic visceral form, characterized by progressive visceral organ symptoms including hepatosplenomegaly and pulmonary insufficiency, and survival into adulthood. In addition, some affected individuals present with an intermediate phenotype, Niemann-Pick disease type A/B.")
AnnotationAssertion(Annotation(oboInOwl:source "MONDO:GARD") oboInOwl:hasDbXref obo:MONDO_0100464 "GARD:0026231")
AnnotationAssertion(Annotation(oboInOwl:source "MONDO:MEDGEN") Annotation(oboInOwl:source "MONDO:equivalentTo") oboInOwl:hasDbXref obo:MONDO_0100464 "MEDGEN:1800807")
AnnotationAssertion(Annotation(oboInOwl:source "MEDGEN:1800807") Annotation(oboInOwl:source "MONDO:MEDGEN") Annotation(oboInOwl:source "MONDO:equivalentTo") oboInOwl:hasDbXref obo:MONDO_0100464 "UMLS:C5243927")
AnnotationAssertion(oboInOwl:id obo:MONDO_0100464 "MONDO:0100464")
AnnotationAssertion(rdfs:label obo:MONDO_0100464 "acid sphingomyelinase deficiency")
AnnotationAssertion(skos:exactMatch obo:MONDO_0100464 <http://identifiers.org/medgen/1800807>)
AnnotationAssertion(skos:exactMatch obo:MONDO_0100464 <http://linkedlifedata.com/resource/umls/id/C5243927>)
SubClassOf(Annotation(oboInOwl:source "https://clinicalgenome.org/affiliation/40110/") obo:MONDO_0100464 obo:MONDO_0001982)

