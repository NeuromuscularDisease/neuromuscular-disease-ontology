AnnotationAssertion(rdfs:label <https://www.genenames.org/data/genegroup/#!/group/694> "Protein phosphatase 1 regulatory subunits")
SubClassOf(<https://www.genenames.org/data/genegroup/#!/group/694> obo:SO_0005855)

# Class: <https://www.genenames.org/data/genegroup/#!/group/701> (Protein phosphatases, Mg2+/Mn2+ dependent)

AnnotationAssertion(terms:description <https://www.genenames.org/data/genegroup/#!/group/701> "The PPM family, which includes PP2C [PPM1] and pyruvate dehydrogenase phosphatase, are enzymes with Mn2+/Mg2+ metal ions that are resistant to classic inhibitors and toxins of the PPP family.")
