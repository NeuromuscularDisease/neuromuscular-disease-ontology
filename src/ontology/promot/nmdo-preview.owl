# Class: obo:HP_0002027 (Abdominal pain)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref <https://orcid.org/0000-0002-0736-9199>) obo:IAO_0000115 obo:HP_0002027 "An unpleasant sensation characterized by physical discomfort (such as pricking, throbbing, or aching) and perceived to originate in the abdomen.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType hp:layperson) oboInOwl:hasBroadSynonym obo:HP_0002027 "Gastro pain")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType hp:layperson) oboInOwl:hasBroadSynonym obo:HP_0002027 "Gastrointestinal pain")
AnnotationAssertion(Annotation(rdfs:label "Abdominal pain") oboInOwl:hasDbXref obo:HP_0002027 "MEDDRA:10000081")
AnnotationAssertion(oboInOwl:hasDbXref obo:HP_0002027 "SNOMEDCT_US:21522001")
AnnotationAssertion(oboInOwl:hasDbXref obo:HP_0002027 "UMLS:C0000737")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType hp:layperson) oboInOwl:hasExactSynonym obo:HP_0002027 "Abdominal pain")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType hp:layperson) oboInOwl:hasExactSynonym obo:HP_0002027 "Pain in stomach")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref <https://orcid.org/0000-0002-0736-9199>) Annotation(oboInOwl:hasSynonymType hp:layperson) oboInOwl:hasExactSynonym obo:HP_0002027 "Stomach pain")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType hp:layperson) oboInOwl:hasRelatedSynonym obo:HP_0002027 "Abdominal discomfort")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref <https://orcid.org/0000-0001-6439-2224>) Annotation(oboInOwl:hasSynonymType hp:layperson) oboInOwl:hasRelatedSynonym obo:HP_0002027 "Upset stomach")
AnnotationAssertion(oboInOwl:id obo:HP_0002027 "HP:0002027")
AnnotationAssertion(rdfs:comment obo:HP_0002027 "Abdominal pain can be crampy, achy, dull, intermittent or sharp. The terms stomach ache and stomach cramps are nonmedical terms often used to describe pain in the mid- or upper abdominal area, even though it is not the case that the (smooth) muscles of the stomach or the abdomen have cramps. Stomach pain is another layperson term commonly used to refer to abdominal pain.")
AnnotationAssertion(rdfs:label obo:HP_0002027 "Abdominal pain")
SubClassOf(obo:HP_0002027 obo:HP_0011458)
SubClassOf(obo:HP_0002027 obo:HP_0012531)

# Class: obo:HP_0002047 (Malignant hyperthermia)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref <https://orcid.org/0000-0002-0736-9199>) obo:IAO_0000115 obo:HP_0002047 "Malignant hyperthermia is characterized by a rapid increase in temperature to 39-42 degrees C. Malignant hyperthermia may occur in response to either inhalational anesthetics such as halothane, to muscle relaxants such as succinylcholine, or to exercise.")
AnnotationAssertion(oboInOwl:hasAlternativeId obo:HP_0002047 "HP:0004896")
