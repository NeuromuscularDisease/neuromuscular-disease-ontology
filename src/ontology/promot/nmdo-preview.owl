AnnotationAssertion(Annotation(oboInOwl:hasDbXref "Orphanet:319332") oboInOwl:hasExactSynonym obo:MONDO_0017892 "SYNE1-related arthrogryposis multiplex congenita")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "Orphanet:319332") oboInOwl:hasExactSynonym obo:MONDO_0017892 "autosomal recessive myogenic AMC")
