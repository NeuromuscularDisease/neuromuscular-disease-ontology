AnnotationAssertion(oboInOwl:hasExactSynonym obo:HP_0025270 "Functional abnormality of the esophagus")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType hp:uk_spelling) oboInOwl:hasExactSynonym obo:HP_0025270 "Functional abnormality of the oesophagus")
AnnotationAssertion(rdfs:label obo:HP_0025270 "Abnormal esophagus physiology")
SubClassOf(obo:HP_0025270 obo:HP_0012719)

