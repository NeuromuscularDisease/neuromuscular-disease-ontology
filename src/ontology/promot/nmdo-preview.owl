AnnotationAssertion(Annotation(oboInOwl:source "MEDGEN:1647584") Annotation(oboInOwl:source "MONDO:MEDGEN") Annotation(oboInOwl:source "MONDO:equivalentTo") oboInOwl:hasDbXref obo:MONDO_0018370 "UMLS:C4706574")
