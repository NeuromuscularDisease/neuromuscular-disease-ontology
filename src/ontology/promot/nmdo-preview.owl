AnnotationAssertion(terms:description <https://www.genenames.org/data/genegroup/#!/group/430> "This functional set of mannosyltransferases all use dolichyl D-mannosyl phosphate (dol-P-Man) as a sugar donor.")
AnnotationAssertion(rdfs:label <https://www.genenames.org/data/genegroup/#!/group/430> "Dolichyl D-mannosyl phosphate dependent mannosyltransferases")
