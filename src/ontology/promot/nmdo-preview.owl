AnnotationAssertion(oboInOwl:hasDbXref obo:UBERON_0003220 "EMAPA:17375")
AnnotationAssertion(oboInOwl:hasDbXref obo:UBERON_0003220 "SCTID:361529008")
AnnotationAssertion(oboInOwl:hasDbXref obo:UBERON_0003220 "VHOG:0000540")
AnnotationAssertion(oboInOwl:hasDbXref obo:UBERON_0003220 "Wikipedia:Metanephric_blastema")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "Wikipedia:Metanephric_blastema") oboInOwl:hasExactSynonym obo:UBERON_0003220 "metanephric blastema")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "Wikipedia:Metanephric_blastema") oboInOwl:hasExactSynonym obo:UBERON_0003220 "metanephric mesoderm")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "EHDAA:5021") oboInOwl:hasExactSynonym obo:UBERON_0003220 "metanephrogenic mesenchyme")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "RETIRED_EHDAA2:0001139") oboInOwl:hasExactSynonym obo:UBERON_0003220 "metanephros associated mesenchyme")
AnnotationAssertion(oboInOwl:id obo:UBERON_0003220 "UBERON:0003220")
AnnotationAssertion(rdfs:comment obo:UBERON_0003220 "Genes: The positional specification of the metanephrogenic mesenchyme is negatively regulated by Foxc1 and Foxc2. Next the permanent kidney forming metanephrogenic mesenchyme is specified by Hox11 genes. The competence to respond to ureteric bud inducers is regulated by WT1. GDNF secretion restricted to posterior region by Robo2 and Sprouty1. The receptors for GDNF are synthesized in the nephric ducts and later in ureteric buds [ISBN:9780878932504 \"Developmental Biology\"]")
AnnotationAssertion(rdfs:label obo:UBERON_0003220 "metanephric mesenchyme")
