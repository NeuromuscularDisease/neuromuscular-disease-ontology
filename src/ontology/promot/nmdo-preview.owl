# Class: obo:NCIT_C102117 (Assessment using Berg Balance Scale)

AnnotationAssertion(Annotation(obo:NCIT_P378 "NCI") obo:IAO_0000115 obo:NCIT_C102117 "A standardized rating scale which is used as a measure of health outcome. This instrument is a descriptive system consisting of 5 dimensions: mobility, self-care, usual activity, pain/discomfort, and anxiety/depression. Each dimension has 5 levels ranging from no problem to extreme problem or incapable, which are assessed by the patient.")
AnnotationAssertion(Annotation(oboInOwl:source "http://purl.obolibrary.org/obo/PROMOT_0100011") obo:IAO_0000115 obo:NCIT_C102117 "An assessment with the Berg scale assesses balance and identifies the level of fall risk. This five-level ordinal scale (0 to 4) contains 14 items and the maximum total score ranges from 0 (maximum reach) to 56 (no reach detected). This generic scale evaluates various dimensions of balance, including the following: maintaining multiple positions, having automatic postural responses when changing posture or voluntary movements of the limbs, and produce effective balance and protection reactions.")
AnnotationAssertion(obo:NCIT_P207 obo:NCIT_C102117 "C3640517")
AnnotationAssertion(oboInOwl:hasDbXref obo:NCIT_C102117 "http://purl.obolibrary.org/obo/PROMOT_0100011")
AnnotationAssertion(Annotation(obo:NCIT_P383 "AB") Annotation(obo:NCIT_P383 "PT") Annotation(obo:NCIT_P383 "SY") Annotation(obo:NCIT_P384 "CDISC") Annotation(obo:NCIT_P384 "NCI") Annotation(obo:NCIT_P384 "caDSR") oboInOwl:hasExactSynonym obo:NCIT_C102117 "EQ-5D-5L")
AnnotationAssertion(Annotation(obo:NCIT_P383 "SY") Annotation(obo:NCIT_P384 "CDISC") oboInOwl:hasExactSynonym obo:NCIT_C102117 "EQ5D02")
AnnotationAssertion(Annotation(obo:NCIT_P383 "PT") Annotation(obo:NCIT_P384 "NCI") oboInOwl:hasExactSynonym obo:NCIT_C102117 "European Quality of Life Five Dimension Five Level Scale Questionnaire")
AnnotationAssertion(rdfs:comment obo:NCIT_C102117 "PROMOT mapping: 'Assessment using Berg Balance Scale' (LLM score: 0.4439) | Candidates: European Quality of Life Five Dimension Five Level Scale Questionnaire [0.444] | 12-Item Multiple Sclerosis Walking Scale Questionnaire [0.426] | Eating Assessment Tool-10 [0.321]")
AnnotationAssertion(rdfs:label obo:NCIT_C102117 "European Quality of Life Five Dimension Five Level Scale Questionnaire")
AnnotationAssertion(Annotation(oboInOwl:source "http://purl.obolibrary.org/obo/PROMOT_0100011") rdfs:label obo:NCIT_C102117 "Assessment using Berg Balance Scale")
AnnotationAssertion(Annotation(oboInOwl:source "http://purl.obolibrary.org/obo/PROMOT_0100011") nmdo:assesses_phenotype obo:NCIT_C102117 "http://purl.obolibrary.org/obo/HP_0002141")
