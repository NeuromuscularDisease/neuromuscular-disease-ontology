AnnotationAssertion(Annotation(oboInOwl:hasSynonymType mondo:ABBREVIATION) oboInOwl:hasExactSynonym obo:MONDO_0018098 "LGMD1E")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "GARD:0012529") oboInOwl:hasRelatedSynonym obo:MONDO_0018098 "limb-girdle muscular dystrophy type 1E")
AnnotationAssertion(oboInOwl:id obo:MONDO_0018098 "MONDO:0018098")
AnnotationAssertion(rdfs:comment obo:MONDO_0018098 "Terminology notes: See comments for LGMD1D")
AnnotationAssertion(rdfs:label obo:MONDO_0018098 "autosomal dominant limb-girdle muscular dystrophy type 1E (DES)")
