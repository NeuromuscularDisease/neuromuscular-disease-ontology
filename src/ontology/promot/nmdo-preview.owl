AnnotationAssertion(Annotation(oboInOwl:hasSynonymType hp:layperson) oboInOwl:hasRelatedSynonym obo:HP_0001250 "Epilepsy")
AnnotationAssertion(oboInOwl:id obo:HP_0001250 "HP:0001250")
AnnotationAssertion(rdfs:comment obo:HP_0001250 "A type of electrographic seizure has been proposed in neonates which does not have a clinical correlate, it is electrographic only. The term epilepsy is not used to describe recurrent febrile seizures. Epilepsy presumably reflects an abnormally reduced seizure threshold.")
AnnotationAssertion(rdfs:label obo:HP_0001250 "Seizure")
