AnnotationAssertion(oboInOwl:hasNarrowSynonym obo:MONDO_0017343 "Epstein-Barr virus-associated malignant lymphoproliferative disorder")
AnnotationAssertion(oboInOwl:id obo:MONDO_0017343 "MONDO:0017343")
