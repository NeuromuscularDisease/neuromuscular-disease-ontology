AnnotationAssertion(oboInOwl:hasExactSynonym obo:HP_0002460 "Muscle weakness, distal limbs, due to neuronopathy")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:HP_0002460 "Weakness of distal muscles")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref <https://orcid.org/0000-0001-5208-3432>) Annotation(oboInOwl:hasSynonymType hp:layperson) oboInOwl:hasExactSynonym obo:HP_0002460 "Weakness of outermost muscles")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref <https://orcid.org/0000-0002-5316-1399>) oboInOwl:hasRelatedSynonym obo:HP_0002460 "Distal limb muscle weakness due to peripheral neuropathy")
