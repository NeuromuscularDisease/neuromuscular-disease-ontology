# Class: obo:MONDO_0100062 (genetic developmental and epileptic encephalopathy)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PMID:28276062") obo:IAO_0000115 obo:MONDO_0100062 "A complex neurodevelopmental disorder characterized by a range of developmental delays and epileptic encephalopathy phenotypes. Seizure onset is variable and intellectual disability is variable in presence and severity.")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "https://orcid.org/0000-0001-8486-0558") oboInOwl:hasBroadSynonym obo:MONDO_0100062 "developmental and epileptic encephalopathy")
AnnotationAssertion(Annotation(oboInOwl:source "MONDO:equivalentTo") oboInOwl:hasDbXref obo:MONDO_0100062 "DOID:0112202")
AnnotationAssertion(Annotation(oboInOwl:source "MONDO:GARD") oboInOwl:hasDbXref obo:MONDO_0100062 "GARD:0009255")
AnnotationAssertion(Annotation(oboInOwl:source "MONDO:i2s") Annotation(oboInOwl:source "MONDO:relatedTo") oboInOwl:hasDbXref obo:MONDO_0100062 "ICD9:345.10")
AnnotationAssertion(Annotation(oboInOwl:source "MONDO:NANDO") Annotation(oboInOwl:source "https://orcid.org/0000-0002-0170-9172") Annotation(oboInOwl:source "https://orcid.org/0000-0003-0011-764X") oboInOwl:hasDbXref obo:MONDO_0100062 "NANDO:1200593")
AnnotationAssertion(Annotation(oboInOwl:source "MONDO:equivalentTo") oboInOwl:hasDbXref obo:MONDO_0100062 "NCIT:C122814")
AnnotationAssertion(Annotation(oboInOwl:source "MONDO:equivalentTo") Annotation(oboInOwl:source "MONDO:pnr") oboInOwl:hasDbXref obo:MONDO_0100062 "OMIMPS:308350")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "https://orcid.org/0000-0001-5208-3432") oboInOwl:hasNarrowSynonym obo:MONDO_0100062 "hereditary developmental and epileptic encephalopathy")
AnnotationAssertion(oboInOwl:id obo:MONDO_0100062 "MONDO:0100062")
AnnotationAssertion(rdfs:comment obo:MONDO_0100062 "Individuals, both male and female, have been reported with variants in the GABRB3 gene. De novo and familial cases have been reported, with mostly missense and a few nonsense variants identified as causative. These patients have been described in the literature as having a range of phenotypes characterized as epileptic encephalopathy, Lennox-Gastaut syndrome, Dravet syndrome-like, and childhood absence epilepsy. Severity of intellectual disability is variable among reported probands, as is the age of onset of seizure phenotypes. In one case of epileptic encephalopathy, for example, the individual presented with severe intellectual disability while seizures onset at 12 years old. Additionally, individuals have been reported with the same de novo missense variants, and have been described with varying phenotypes. (PMID:26544041, PMID:26704558, PMID:26645412, PMID:26993267, PMID:27476654)")
AnnotationAssertion(rdfs:label obo:MONDO_0100062 "genetic developmental and epileptic encephalopathy")
AnnotationAssertion(skos:exactMatch obo:MONDO_0100062 obo:DOID_0112202)
AnnotationAssertion(skos:exactMatch obo:MONDO_0100062 obo:NCIT_C122814)
AnnotationAssertion(skos:exactMatch obo:MONDO_0100062 <https://omim.org/phenotypicSeries/PS308350>)
EquivalentClasses(obo:MONDO_0100062 ObjectIntersectionOf(obo:MONDO_0100620 ObjectSomeValuesFrom(obo:RO_0000053 obo:MONDO_0021152)))
SubClassOf(obo:MONDO_0100062 obo:MONDO_0100500)
SubClassOf(Annotation(oboInOwl:source "https://orcid.org/0000-0001-5208-3432") obo:MONDO_0100062 obo:MONDO_0100620)

