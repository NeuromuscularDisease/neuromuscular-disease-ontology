# Class: obo:UBERON_0036264 (zygomaticotemporal nerve)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "Wikipedia:Zygomaticotemporal_nerve") obo:IAO_0000115 obo:UBERON_0036264 "The zygomaticotemporal nerve or zygomaticotemporal branch (temporal branch) is derived from the maxillary branch of the trigeminal nerve (Cranial nerve V). It runs along the lateral wall of the orbit in a groove in the zygomatic bone, receives a branch of communication from the lacrimal, and passes through zygomaticotemporal foramen in the zygomatic bone to enter the temporal fossa. It ascends between the bone, and substance of the Temporalis muscle, pierces the temporal fascia about 2.5 cm. above the zygomatic arch, and is distributed to the skin of the side of the forehead, and communicates with the facial nerve and with the auriculotemporal branch of the mandibular nerve. As it pierces the temporal fascia, it gives off a slender twig, which runs between the two layers of the fascia to the lateral angle of the orbit.")
AnnotationAssertion(oboInOwl:hasDbXref obo:UBERON_0036264 "FMA:52972")
AnnotationAssertion(oboInOwl:hasDbXref obo:UBERON_0036264 "SCTID:280243001")
AnnotationAssertion(oboInOwl:hasDbXref obo:UBERON_0036264 "Wikipedia:Zygomaticotemporal_nerve")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "FMA:52972") oboInOwl:hasExactSynonym obo:UBERON_0036264 "ramus zygomaticotemporalis (Nervus zygomaticus)")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "FMA:TA") Annotation(oboInOwl:hasSynonymType obo:OMO_0003011) oboInOwl:hasExactSynonym obo:UBERON_0036264 "ramus zygomaticotemporalis nervus zygomatici")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "FMA:52972") oboInOwl:hasExactSynonym obo:UBERON_0036264 "zygomaticotemporal branch of zygomatic nerve")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "Wikipedia:Zygomaticotemporal_nerve") oboInOwl:hasRelatedSynonym obo:UBERON_0036264 "zygomaticotemporal")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "Wikipedia:Zygomaticotemporal_nerve") oboInOwl:hasRelatedSynonym obo:UBERON_0036264 "zygomaticotemporal branch")
AnnotationAssertion(oboInOwl:id obo:UBERON_0036264 "UBERON:0036264")
AnnotationAssertion(rdfs:label obo:UBERON_0036264 "zygomaticotemporal nerve")
