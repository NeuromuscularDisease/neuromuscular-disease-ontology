# Class: obo:UBERON_0002532 (epiblast (generic))

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "Wikipedia:Epiblast") Annotation(oboInOwl:hasDbXref "ZFIN:curator") obo:IAO_0000115 obo:UBERON_0002532 "In amniote animal embryology, the epiblast is a tissue type derived either from the inner cell mass in mammals or the blastodisc in birds and reptiles. It lies above the hypoblast. In mammalian embryogenesis, the columnar cells of the epiblast are adjacent to the trophoblast, while the cuboidal cells of the hypoblast are closer to the blastocoele. The epiblast, whilst referred to as the primary ectoderm, differentiates to form all three layers of the trilaminar germ disc in a process called gastrulation[WP]. The outer of the two layers of the blastoderm that form during gastrulation, corresponding to primitive ectoderm during gastrulation and to the definitive ectoderm after gastrulation[ZFA].")
AnnotationAssertion(obo:IAO_0000116 obo:UBERON_0002532 "MP says - tissue that gives rise to the ectoderm, endoderm and mesoderm of the embryo proper. In HOG, epiblast is part of primitive streak/blastpore, which is inconsistent with the MP definition of primitive streak as a ridge of the epiblast. Note that these terms, epiblast and hypoblast, are also used to describe layers of the avian embryonic blastoderm, but the layers so-named seem to be altogether different in these two kinds of vertebrate embryos(CVS). Consider obsoleting this as a grouping class")
AnnotationAssertion(oboInOwl:hasDbXref obo:UBERON_0002532 "BTO:0004593")
AnnotationAssertion(oboInOwl:hasDbXref obo:UBERON_0002532 "FMA:296704")
AnnotationAssertion(oboInOwl:hasDbXref obo:UBERON_0002532 "MAT:0000067")
AnnotationAssertion(oboInOwl:hasDbXref obo:UBERON_0002532 "MIAA:0000067")
AnnotationAssertion(oboInOwl:hasDbXref obo:UBERON_0002532 "VHOG:0000243")
AnnotationAssertion(oboInOwl:hasDbXref obo:UBERON_0002532 "Wikipedia:Epiblast")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "VHOG:0000243") oboInOwl:hasExactSynonym obo:UBERON_0002532 "epiblast")
AnnotationAssertion(oboInOwl:hasRelatedSynonym obo:UBERON_0002532 "blastocyst")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "MP:0003886") oboInOwl:hasRelatedSynonym obo:UBERON_0002532 "ectoblast")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "Wikipedia:Epiblast") Annotation(oboInOwl:hasSynonymType obo:OMO_0003011) oboInOwl:hasRelatedSynonym obo:UBERON_0002532 "epiblastus")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "VHOG:0000243") oboInOwl:hasRelatedSynonym obo:UBERON_0002532 "primitive ectoderm")
AnnotationAssertion(oboInOwl:id obo:UBERON_0002532 "UBERON:0002532")
AnnotationAssertion(rdfs:label obo:UBERON_0002532 "epiblast (generic)")
SubClassOf(obo:UBERON_0002532 obo:UBERON_0002050)

