AnnotationAssertion(oboInOwl:id obo:HP_0003401 "HP:0003401")
AnnotationAssertion(rdfs:comment obo:HP_0003401 "PROMOT mapping: 'Assessment of pinch strengh using B & L gauge' (LLM score: 0.2953) | Candidates: Paresthesia [0.295] | Grip Strength [0.257] | Symptom Specific Assessment Tool [0.225]")
AnnotationAssertion(rdfs:label obo:HP_0003401 "Paresthesia")
