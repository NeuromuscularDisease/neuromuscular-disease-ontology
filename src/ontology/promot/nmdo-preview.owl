# Class: obo:MONDO_0100455 (neonatal-onset developmental and epileptic encephalopathy)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "https://clinicalgenome.org/affiliation/40005/") obo:IAO_0000115 obo:MONDO_0100455 "A complex neurodevelopmental disorder characterized by a neonatal onset of recurrent seizures, an abnormal neonatal electroencephalographic background with multifocal epileptiform discharges, excessive discontinuity, and/or burst-suppression patterns, and encephalopathy. Seizures may be pharmacoresistant or responsive. Developmental delays persist but vary in severity. In some individuals, subsequent evolution to other epileptic encephalopathy syndromes (e.g. West syndrome) may occur.")
AnnotationAssertion(Annotation(oboInOwl:source "MONDO:GARD") oboInOwl:hasDbXref obo:MONDO_0100455 "GARD:0026229")
AnnotationAssertion(oboInOwl:id obo:MONDO_0100455 "MONDO:0100455")
AnnotationAssertion(rdfs:label obo:MONDO_0100455 "neonatal-onset developmental and epileptic encephalopathy")
