AnnotationAssertion(oboInOwl:id obo:MONDO_0034041 "MONDO:0034041")
AnnotationAssertion(rdfs:label obo:MONDO_0034041 "congenital axonal neuropathy with encephalopathy")
AnnotationAssertion(skos:exactMatch obo:MONDO_0034041 <http://identifiers.org/medgen/1814475>)
AnnotationAssertion(skos:exactMatch obo:MONDO_0034041 <http://linkedlifedata.com/resource/umls/id/C5681314>)
