SubClassOf(obo:HP_0002460 obo:HP_0001324)

# Class: obo:HP_0002493 (Upper motor neuron dysfunction)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref <https://orcid.org/0000-0002-0736-9199>) obo:IAO_0000115 obo:HP_0002493 "A functional anomaly of the upper motor neuron. The upper motor neurons are neurons of the primary motor cortex which project to the brainstem and spinal chord via the corticonuclear, corticobulbar and corticospinal (pyramidal) tracts. They are involved in control of voluntary movements. Dysfunction leads to weakness, impairment of fine motor movements, spasticity, hyperreflexia and abnormal pyramidal signs.")
AnnotationAssertion(oboInOwl:hasDbXref obo:HP_0002493 "UMLS:C1504405")
AnnotationAssertion(oboInOwl:hasDbXref obo:HP_0002493 "UMLS:C1839042")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:HP_0002493 "Corticospinal tract dysfunction")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:HP_0002493 "Pyramidal tract dysfunction")
AnnotationAssertion(oboInOwl:id obo:HP_0002493 "HP:0002493")
AnnotationAssertion(rdfs:comment obo:HP_0002493 "A functional deficit of the tract that conveys nervous impulses from the motor cortex of the brain to the spinal cord. The corticospinal tract mediates discrete voluntary skilled movements. Clinical features of corticospinal tract dysfunction may include spasticity and weakness, particularly affecting the lower limbs, as well as hyperreflexia, clonus at the ankles and knees, and extensor plantar responses (Babinski response).")
AnnotationAssertion(rdfs:label obo:HP_0002493 "Upper motor neuron dysfunction")
SubClassOf(obo:HP_0002493 obo:HP_0011442)

