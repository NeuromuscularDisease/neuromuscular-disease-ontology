AnnotationAssertion(Annotation(oboInOwl:source "GARD:0009461") rdfs:seeAlso obo:MONDO_0021950 "https://rarediseases.info.nih.gov/diseases/9461/autoimmune-oophoritis"^^xsd:anyURI)
