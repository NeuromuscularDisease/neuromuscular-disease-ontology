AnnotationAssertion(Annotation(oboInOwl:hasDbXref "FMA:5866") oboInOwl:hasExactSynonym obo:UBERON_0034728 "visceral nerve")
AnnotationAssertion(oboInOwl:id obo:UBERON_0034728 "UBERON:0034728")
AnnotationAssertion(rdfs:label obo:UBERON_0034728 "autonomic nerve")
