AnnotationAssertion(Annotation(oboInOwl:source "MONDO:NANDO") Annotation(oboInOwl:source "https://orcid.org/0000-0002-0170-9172") Annotation(oboInOwl:source "https://orcid.org/0000-0003-0011-764X") oboInOwl:hasDbXref obo:MONDO_0015358 "NANDO:2200855")
