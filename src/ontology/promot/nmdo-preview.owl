# Class: obo:MONDO_0100150 (RYR1-related myopathy)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PMID:30406384") Annotation(oboInOwl:hasDbXref "https://clinicalgenome.org/affiliation/40031/") obo:IAO_0000115 obo:MONDO_0100150 "A disorder of the musculoskeletal system caused by pathogenic variants in the RYR1 gene, which encodes the ryanodine receptor type 1 protein. These variants are associated with a variety of overlapping features characterized by symmetric proximal muscle weakness, often with pronounced facial weakness with or without dysmorphism and ophthalmoparesis/ophthalmoplegia with ptosis, bulbar weakness, significant respiratory involvement, severe neonatal hypotonia, scoliosis, orthopedic deformities including arthrogryposis, hip dislocation, club feet, and King Denborough syndrome (pectus carinatum or excavatum, short stature, joint contractures, facial and skeletal deformities), malignant hyperthermia susceptibility, anesthesia-induced rhabdomyolysis, fatigue, exercise-induced hyperthermia/exertional heat stroke, and exertional myalgia. Histologic findings on skeletal muscle biopsy reveal a wide range of structural abnormalities and can include central core disease, multiminicore disease, cone-rod myopathy, centronuclear myopathy, and congenital fiber-type disproportion.")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "https://rarediseases.org/rare-diseases/ryr-1-related-diseases/") oboInOwl:hasBroadSynonym obo:MONDO_0100150 "RYR1-related disease")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "https://rarediseases.org/rare-diseases/ryr-1-related-diseases/") oboInOwl:hasBroadSynonym obo:MONDO_0100150 "RYR1-related disorder")
AnnotationAssertion(Annotation(oboInOwl:source "MONDO:GARD") oboInOwl:hasDbXref obo:MONDO_0100150 "GARD:0026064")
AnnotationAssertion(Annotation(oboInOwl:source "MONDO:equivalentTo") oboInOwl:hasDbXref obo:MONDO_0100150 "Orphanet:98742")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "Orphanet:98742") Annotation(oboInOwl:hasDbXref "https://orcid.org/0000-0001-9310-0163") oboInOwl:hasExactSynonym obo:MONDO_0100150 "neurological muscular channelopathy due to a genetic ryanodine receptor defect")
AnnotationAssertion(oboInOwl:id obo:MONDO_0100150 "MONDO:0100150")
AnnotationAssertion(rdfs:label obo:MONDO_0100150 "RYR1-related myopathy")
AnnotationAssertion(skos:exactMatch obo:MONDO_0100150 <http://www.orpha.net/ORDO/Orphanet_98742>)
EquivalentClasses(Annotation(oboInOwl:source "https://clinicalgenome.org/affiliation/40031/") obo:MONDO_0100150 ObjectIntersectionOf(obo:MONDO_0019952 ObjectSomeValuesFrom(obo:RO_0004003 <http://identifiers.org/hgnc/10483>)))
