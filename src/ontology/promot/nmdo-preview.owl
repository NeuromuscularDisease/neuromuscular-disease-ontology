# Class: obo:UBERON_0002328 (notochord)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "ISBN:0815318960") Annotation(oboInOwl:hasDbXref "Wikipedia:Notochord") Annotation(oboInOwl:hasDbXref "http://tolweb.org/Chordata/2499") Annotation(oboInOwl:hasDbXref "https://github.com/obophenotype/uberon/issues/25") Annotation(oboInOwl:hasDbXref "https://github.com/obophenotype/uberon/issues/271") obo:IAO_0000115 obo:UBERON_0002328 "A flexible rod-shaped body found in embryos of all chordates. It is composed of cells derived from the mesoderm and defines the primitive axis of the embryo. In some chordates, it persists throughout life as the main axial support of the body, while in most vertebrates it becomes the nucleus pulposus of the intervertebral disc. The notochord is found ventral to the neural tube.")
AnnotationAssertion(oboInOwl:hasDbXref obo:UBERON_0002328 "AAO:0000327")
AnnotationAssertion(oboInOwl:hasDbXref obo:UBERON_0002328 "BTO:0001768")
AnnotationAssertion(oboInOwl:hasDbXref obo:UBERON_0002328 "CALOHA:TS-0690")
