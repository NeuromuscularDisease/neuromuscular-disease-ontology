# Class: obo:MONDO_0100175 (TTN-related myopathy)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PMID:27854229") Annotation(oboInOwl:hasDbXref "PMID:29691892") Annotation(oboInOwl:hasDbXref "https://clinicalgenome.org/affiliation/40031/") obo:IAO_0000115 obo:MONDO_0100175 "A disorder of the musculoskeletal system caused by pathogenic variants in the TTN gene encoding the titin protein expressed in striated muscle. These variants are associated with a variety of overlapping congenital and adult-onset myopathies characterized by non-progressive or progressive neck, axial, and limb weakness, joint contractures, early-onset respiratory insufficiency, facial weakness, congenital cardiac anomalies and/or early-onset dilated cardiomyopathy. Histologic findings on skeletal muscle biopsy reveal a wide range of structural abnormalities and can include increased internalized and central nuclei, minicores, and dystrophic changes.")
AnnotationAssertion(Annotation(oboInOwl:source "MONDO:GARD") oboInOwl:hasDbXref obo:MONDO_0100175 "GARD:0026073")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "https://clinicalgenome.org/affiliation/40031/") oboInOwl:hasExactSynonym obo:MONDO_0100175 "TTN myopathy")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "https://clinicalgenome.org/affiliation/40031/") oboInOwl:hasExactSynonym obo:MONDO_0100175 "congenital myopathy related to TTN")
AnnotationAssertion(oboInOwl:id obo:MONDO_0100175 "MONDO:0100175")
AnnotationAssertion(rdfs:comment obo:MONDO_0100175 "In the absence of evidence supporting distinct differences in molecular mechanisms between the associated disease entities, as well as considerable phenotypic overlap, these entities can be considered part of a clinical spectrum of TTN-related myopathy.")
AnnotationAssertion(rdfs:label obo:MONDO_0100175 "TTN-related myopathy")
EquivalentClasses(Annotation(oboInOwl:source "https://clinicalgenome.org/affiliation/40031/") obo:MONDO_0100175 ObjectIntersectionOf(obo:MONDO_0019952 ObjectSomeValuesFrom(obo:RO_0004003 <http://identifiers.org/hgnc/12403>)))
SubClassOf(obo:MONDO_0100175 obo:MONDO_0002320)
SubClassOf(Annotation(oboInOwl:source "https://orcid.org/0000-0002-6601-2165") obo:MONDO_0100175 obo:MONDO_0016191)
SubClassOf(Annotation(oboInOwl:source "https://clinicalgenome.org/affiliation/40031/") obo:MONDO_0100175 obo:MONDO_0019952)
SubClassOf(obo:MONDO_0100175 obo:MONDO_0100545)
SubClassOf(obo:MONDO_0100175 ObjectSomeValuesFrom(obo:RO_0004003 <http://identifiers.org/hgnc/12403>))

