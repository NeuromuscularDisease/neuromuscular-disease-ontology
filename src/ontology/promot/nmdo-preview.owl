AnnotationAssertion(Annotation(oboInOwl:hasDbXref "Orphanet:423776") oboInOwl:hasExactSynonym obo:MONDO_0018502 "hereditary cancer of stomach")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "MONDO:patterns/hereditary") Annotation(oboInOwl:hasDbXref "Orphanet:423776") oboInOwl:hasExactSynonym obo:MONDO_0018502 "hereditary gastric cancer")
