AnnotationAssertion(Annotation(oboInOwl:hasDbXref "Orphanet:86909") oboInOwl:hasExactSynonym obo:MONDO_0100566 "benign myoclonic epilepsy of infancy")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "Orphanet:86909") oboInOwl:hasExactSynonym obo:MONDO_0100566 "benign myoclonus epilepsy of infancy")
