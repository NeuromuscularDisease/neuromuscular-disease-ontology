AnnotationAssertion(oboInOwl:id obo:MONDO_0033838 "MONDO:0033838")
AnnotationAssertion(rdfs:label obo:MONDO_0033838 "radiation-induced plexopathy")
AnnotationAssertion(skos:exactMatch obo:MONDO_0033838 <http://identifiers.org/medgen/1809151>)
AnnotationAssertion(skos:exactMatch obo:MONDO_0033838 <http://linkedlifedata.com/resource/umls/id/C5681446>)
