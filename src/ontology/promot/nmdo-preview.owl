AnnotationAssertion(oboInOwl:hasExactSynonym obo:HP_0008066 "Blister")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType hp:uk_spelling) oboInOwl:hasExactSynonym obo:HP_0008066 "Blistering, generalised")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType hp:layperson) oboInOwl:hasExactSynonym obo:HP_0008066 "Blistering, generalized")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType hp:layperson) oboInOwl:hasExactSynonym obo:HP_0008066 "Blisters")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:HP_0008066 "Skin bullae")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref <https://orcid.org/0000-0002-5316-1399>) Annotation(oboInOwl:hasSynonymType hp:layperson) oboInOwl:hasRelatedSynonym obo:HP_0008066 "Skin blisters")
AnnotationAssertion(oboInOwl:id obo:HP_0008066 "HP:0008066")
AnnotationAssertion(rdfs:comment obo:HP_0008066 "A bulla is a large vesicle described as a rounded or irregularly shaped blister containing serous or seropurulent fluid, equal to or greater than 10mm. In approaching blistering diseases, there are 3 fundamental criteria to consider: (1) the site or level of the blister (or the lowest level of vesiculation): subcorneal, midepidermis, suprabasal, subepidermal; (2) the findings that implicate the mechanism of blister formation (spongiosis, acantholysis, blistering degeneration, or epidermolysis); and (3) the type of inflammation (neutrophilic, lymphocytic, eosinophilic, mixed), if present.")
AnnotationAssertion(rdfs:label obo:HP_0008066 "Abnormal blistering of the skin")
SubClassOf(obo:HP_0008066 obo:HP_0011121)

