SubClassOf(obo:UBERON_0002418 ObjectSomeValuesFrom(obo:RO_0002433 obo:UBERON_0001434))
DisjointClasses(Annotation(oboInOwl:source "https://github.com/obophenotype/uberon/issues/117") obo:UBERON_0002418 obo:UBERON_0002481)

