# Class: obo:MONDO_0100225 (collagen 6-related myopathy)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PMID:21691338") Annotation(oboInOwl:hasDbXref "https://clinicalgenome.org/affiliation/40031/") obo:IAO_0000115 obo:MONDO_0100225 "A qualitative or quantitative defect of collagen 6 disorder that covers a wide spectrum of musculoskeletal phenotypes caused by dominant and recessive mutations in the three major collagen VI genes: COL6A1, COL6A2, and COL6A3. These variants lead to a variety of overlapping phenotypes, ranging from severe congenital muscle weakness, hypotonia, torticollis and contractures with loss or non-development of ambulation on one end and childhood to adult onset mild muscle weakness, stiffness, and joint hyperlaxity on the other.")
AnnotationAssertion(Annotation(oboInOwl:source "MONDO:GARD") oboInOwl:hasDbXref obo:MONDO_0100225 "GARD:0012705")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PMID:18351526") Annotation(oboInOwl:hasDbXref "https://www.ncbi.nlm.nih.gov/books/NBK1503/") Annotation(oboInOwl:hasDbXref "https://www.ninds.nih.gov/health-information/disorders/muscular-dystrophy") oboInOwl:hasExactSynonym obo:MONDO_0100225 "collagen VI-related dystrophy")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PMID:21691338") oboInOwl:hasExactSynonym obo:MONDO_0100225 "collagen VI-related muscle disorder")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PMID:21691338") oboInOwl:hasExactSynonym obo:MONDO_0100225 "collagen VI-related muscular dystrophy")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PMID:21691338") oboInOwl:hasExactSynonym obo:MONDO_0100225 "collagen VI-related myopathy")
AnnotationAssertion(oboInOwl:id obo:MONDO_0100225 "MONDO:0100225")
AnnotationAssertion(rdfs:label obo:MONDO_0100225 "collagen 6-related myopathy")
SubClassOf(Annotation(oboInOwl:source "https://orcid.org/0000-0001-5208-3432") obo:MONDO_0100225 obo:MONDO_0005336)
