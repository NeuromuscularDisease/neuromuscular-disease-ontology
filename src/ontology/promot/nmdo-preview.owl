AnnotationAssertion(Annotation(oboInOwl:hasDbXref "Orphanet:370980") oboInOwl:hasExactSynonym obo:MONDO_1040033 "CMD without intellectual disability")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "Orphanet:370980") oboInOwl:hasExactSynonym obo:MONDO_1040033 "CMD-no MR")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "Orphanet:370980") oboInOwl:hasExactSynonym obo:MONDO_1040033 "congenital muscular dystrophy-dystroglycanopathy without intellectual disability")
