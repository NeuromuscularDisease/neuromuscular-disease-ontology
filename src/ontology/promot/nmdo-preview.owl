# Class: obo:UBERON_0006134 (nerve fiber)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "Wikipedia:Nervous_system_fiber") obo:IAO_0000115 obo:UBERON_0006134 "A threadlike extension of a nerve cell and consists of an axon and myelin sheath (if it is myelinated) in the nervous system. There are nerve fibers in the central nervous system and peripheral nervous system. A nerve fiber may be myelinated and/or unmyelinated. In the central nervous system (CNS), myelin by oligodendroglia cells is formed. Schwann cells form myelin in the peripheral nervous system (PNS). Schwann cells also make a thin covering in an axon without myelin (in the PNS). A peripheral nerve fiber contains an axon, myelin sheath, schwann cells and its endoneurium. There are no endoneurium and schwann cells in the central nervous system.")
AnnotationAssertion(oboInOwl:hasDbXref obo:UBERON_0006134 "BAMS:nfi")
AnnotationAssertion(oboInOwl:hasDbXref obo:UBERON_0006134 "FMA:5914")
AnnotationAssertion(oboInOwl:hasDbXref obo:UBERON_0006134 "MESH:D009412")
AnnotationAssertion(oboInOwl:hasDbXref obo:UBERON_0006134 "SCTID:88545005")
AnnotationAssertion(oboInOwl:hasDbXref obo:UBERON_0006134 "Wikipedia:Nervous_system_fiber")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "FMA:5914") oboInOwl:hasExactSynonym obo:UBERON_0006134 "nerve fibre")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "FMA:5914") Annotation(oboInOwl:hasDbXref "FMA:TA") Annotation(oboInOwl:hasSynonymType obo:OMO_0003011) oboInOwl:hasExactSynonym obo:UBERON_0006134 "neurofibra")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "FMA:5914") oboInOwl:hasExactSynonym obo:UBERON_0006134 "neurofibrum")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "BAMS:nfi") Annotation(oboInOwl:hasSynonymType obo:OMO_0003004) oboInOwl:hasRelatedSynonym obo:UBERON_0006134 "nerve fibers")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "Wikipedia:Nerve_fiber") Annotation(oboInOwl:hasSynonymType obo:OMO_0003011) oboInOwl:hasRelatedSynonym obo:UBERON_0006134 "neurofibra")
