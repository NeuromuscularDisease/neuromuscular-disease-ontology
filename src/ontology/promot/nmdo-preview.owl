# Class: obo:MONDO_0021018 (autosomal dominant limb-girdle muscular dystrophy type 1D (DNAJB6))

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "Orphanet:34516") Annotation(oboInOwl:hasDbXref "https://www.ncbi.nlm.nih.gov/pmc/articles/PMC4021627/") obo:IAO_0000115 obo:MONDO_0021018 "Autosomal dominant limb-girdle muscular dystrophy type 1D (LGMD1D) is a subtype of autosomal dominant limb-girdle muscular dystrophy characterized by an adult-onset of slowly progressive, proximal pelvic girdle weakness, with none, or only minimal, shoulder girdle involvement, and absence of cardiac and respiratory symptoms. Mild to moderate elevated creatine kinase serum levels and gait abnormalities are frequently observed. LGMD1D is caused by heterozygous missense mutations in the DNAJB6 gene at chr. 7q36.3.")
AnnotationAssertion(Annotation(oboInOwl:source "MONDO:equivalentTo") oboInOwl:hasDbXref obo:MONDO_0021018 "DOID:0110305")
AnnotationAssertion(Annotation(oboInOwl:source "MONDO:GARD") oboInOwl:hasDbXref obo:MONDO_0021018 "GARD:0012528")
AnnotationAssertion(Annotation(oboInOwl:source "MONDO:MEDGEN") Annotation(oboInOwl:source "MONDO:equivalentTo") oboInOwl:hasDbXref obo:MONDO_0021018 "MEDGEN:1648441")
AnnotationAssertion(Annotation(oboInOwl:source "MONDO:equivalentTo") oboInOwl:hasDbXref obo:MONDO_0021018 "MESH:C566370")
AnnotationAssertion(Annotation(oboInOwl:source "MONDO:equivalentTo") Annotation(oboInOwl:source "Orphanet:34516") Annotation(oboInOwl:source "Orphanet:34516/e") Annotation(oboInOwl:source "https://orcid.org/0000-0002-6601-2165") oboInOwl:hasDbXref obo:MONDO_0021018 "OMIM:603511")
AnnotationAssertion(Annotation(oboInOwl:source "DOID:0110305") Annotation(oboInOwl:source "MONDO:equivalentTo") oboInOwl:hasDbXref obo:MONDO_0021018 "Orphanet:34516")
