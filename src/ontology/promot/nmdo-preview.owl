# Class: obo:HP_0012378 (Fatigue)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref <https://orcid.org/0000-0002-0736-9199>) obo:IAO_0000115 obo:HP_0012378 "A subjective feeling of tiredness characterized by a lack of energy and motivation.")
AnnotationAssertion(Annotation(oboInOwl:source "http://purl.obolibrary.org/obo/PROMOT_0100015") obo:IAO_0000115 obo:HP_0012378 "Assessment using Fatigue Severity scale. It follows a 9-item scale which measures the severity of fatigue and its effect on a person's activities and lifestyle in patients with a variety of disorders.  A 9-item questionnaire with questions related to how fatigue interferes with certain activities and rates its severity according to a self-report scale. The items are scored on a 7 point scale with 1 = strongly disagree and 7= strongly agree. The minimum score = 9 and maximum score possible = 63. Higher the score = greater fatigue severity. Another way of scoring: mean of all the scores with minimum score being 1 and maximum score being 7. Lerdal (2011) found that items 1 and 2 in the FSS-9 should not be used in a mean score because the FSS-7 shows better validity and reliability and is likely more sensitive for measuring change in fatigue.")
AnnotationAssertion(oboInOwl:hasDbXref obo:HP_0012378 "SNOMEDCT_US:248274002")
AnnotationAssertion(oboInOwl:hasDbXref obo:HP_0012378 "SNOMEDCT_US:84229001")
AnnotationAssertion(oboInOwl:hasDbXref obo:HP_0012378 "UMLS:C0015672")
AnnotationAssertion(oboInOwl:hasDbXref obo:HP_0012378 "http://purl.obolibrary.org/obo/PROMOT_0100015")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType hp:layperson) oboInOwl:hasExactSynonym obo:HP_0012378 "Fatigue")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType hp:layperson) oboInOwl:hasExactSynonym obo:HP_0012378 "Tired")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType hp:layperson) oboInOwl:hasExactSynonym obo:HP_0012378 "Tiredness")
AnnotationAssertion(oboInOwl:id obo:HP_0012378 "HP:0012378")
AnnotationAssertion(rdfs:comment obo:HP_0012378 "Fatigue is distinct from muscle weakness.")
AnnotationAssertion(rdfs:comment obo:HP_0012378 "PROMOT mapping: 'Assessment using Fatigue Severity Scale (FSS)' (LLM score: 0.5487) | Candidates: Fatigue [0.549] | 6 Minute Walk Functional Test [0.441] | 12-Item Multiple Sclerosis Walking Scale Questionnaire [0.425]")
AnnotationAssertion(rdfs:label obo:HP_0012378 "Fatigue")
AnnotationAssertion(Annotation(oboInOwl:source "http://purl.obolibrary.org/obo/PROMOT_0100015") rdfs:label obo:HP_0012378 "Assessment using Fatigue Severity Scale (FSS)")
AnnotationAssertion(Annotation(oboInOwl:source "http://purl.obolibrary.org/obo/PROMOT_0100015") nmdo:assesses_phenotype obo:HP_0012378 "http://purl.obolibrary.org/obo/HP_0012378")
AnnotationAssertion(Annotation(oboInOwl:source "http://purl.obolibrary.org/obo/PROMOT_0100015") nmdo:assesses_phenotype_label obo:HP_0012378 "Fatigue")
SubClassOf(obo:HP_0012378 obo:HP_0025142)

