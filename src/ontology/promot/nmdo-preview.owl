AnnotationAssertion(Annotation(oboInOwl:source "MEDGEN:1642781") Annotation(oboInOwl:source "MONDO:MEDGEN") Annotation(oboInOwl:source "MONDO:equivalentTo") oboInOwl:hasDbXref obo:MONDO_0018528 "UMLS:C4706390")
