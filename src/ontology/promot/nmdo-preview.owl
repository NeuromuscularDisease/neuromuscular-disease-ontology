AnnotationAssertion(Annotation(oboInOwl:hasSynonymType hp:uk_spelling) oboInOwl:hasExactSynonym obo:HP_0002098 "Laboured breathing")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:HP_0002098 "Respiratory difficulties")
