# Class: obo:UBERON_0006268 (notochordal process)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "http://www.med.umich.edu/lrc/coursepages/m1/embryology/embryo/05embryonicperiod.htm") obo:IAO_0000115 obo:UBERON_0006268 "A midline cellular cord formed from the migration of mesenchymal cells from the primitive knot.")
AnnotationAssertion(oboInOwl:hasDbXref obo:UBERON_0006268 "EHDAA2:0001279")
AnnotationAssertion(oboInOwl:hasDbXref obo:UBERON_0006268 "EHDAA:224")
AnnotationAssertion(oboInOwl:hasDbXref obo:UBERON_0006268 "EMAPA:16102")
AnnotationAssertion(oboInOwl:hasDbXref obo:UBERON_0006268 "FMA:293135")
AnnotationAssertion(oboInOwl:hasDbXref obo:UBERON_0006268 "NCIT:C34232")
AnnotationAssertion(Annotation(oboInOwl:source "ncithesaurus:Notochordal_Process") oboInOwl:hasDbXref obo:UBERON_0006268 "UMLS:C1518430")
AnnotationAssertion(oboInOwl:hasDbXref obo:UBERON_0006268 "VHOG:0001213")
AnnotationAssertion(oboInOwl:hasRelatedSynonym obo:UBERON_0006268 "chordamesoderm")
AnnotationAssertion(oboInOwl:hasRelatedSynonym obo:UBERON_0006268 "presumptive notochord")
AnnotationAssertion(oboInOwl:id obo:UBERON_0006268 "UBERON:0006268")
AnnotationAssertion(rdfs:comment obo:UBERON_0006268 "The notochordal process grows cranially until it reaches the prechordal plate, the future site of the mouth. In this area the ectoderm is attached directly to the endoderm without intervening mesoderm. This area is known as the oropharyngeal membrane, and it will break down to become the mouth. At the other end of the primitive streak the ectoderm is also fused directly to the endoderm; this is known as the cloacal membrane (proctodeum), or primordial anus.")
AnnotationAssertion(rdfs:label obo:UBERON_0006268 "notochordal process")
SubClassOf(obo:UBERON_0006268 obo:UBERON_0005423)
SubClassOf(Annotation(oboInOwl:source "EHDAA2") obo:UBERON_0006268 ObjectSomeValuesFrom(obo:RO_0002202 obo:UBERON_0000924))

