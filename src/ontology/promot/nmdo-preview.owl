AnnotationAssertion(Annotation(oboInOwl:hasDbXref "ZFA:0001719") oboInOwl:hasExactSynonym obo:UBERON_0006283 "presumptive cardiac ventricle heart tube")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "EHDAA2:0001531") oboInOwl:hasExactSynonym obo:UBERON_0006283 "primitive ventricle")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "EMAPA:16350") oboInOwl:hasExactSynonym obo:UBERON_0006283 "primitive ventricle of heart")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "FMA:71006") oboInOwl:hasExactSynonym obo:UBERON_0006283 "primordial cardiac ventricle")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "FMA:71006") oboInOwl:hasExactSynonym obo:UBERON_0006283 "primordial ventricle")
AnnotationAssertion(oboInOwl:id obo:UBERON_0006283 "UBERON:0006283")
AnnotationAssertion(rdfs:comment obo:UBERON_0006283 "The embryonic ventricle or primitive ventricle of the developing heart gives rise to the trabeculated parts of the left and right ventricles. In contrast, the smooth parts of the left and right ventricles originate from the embryological bulbus cordis. The primitive ventricle becomes divided by a septum, the septum inferius or ventricular septum, which grows upward from the lower part of the ventricle, its position being indicated on the surface of the heart by a furrow. Its dorsal part increases more rapidly than its ventral portion, and fuses with the dorsal part of the septum intermedium. For a time an interventricular foramen exists above its ventral portion, but this foramen is ultimately closed by the fusion of the aortic septum with the ventricular septum[WP]")
AnnotationAssertion(rdfs:label obo:UBERON_0006283 "future cardiac ventricle")
SubClassOf(obo:UBERON_0006283 obo:UBERON_0006598)
SubClassOf(obo:UBERON_0006283 ObjectSomeValuesFrom(obo:RO_0002387 obo:UBERON_0002082))

