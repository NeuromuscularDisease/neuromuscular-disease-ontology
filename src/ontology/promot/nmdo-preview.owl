AnnotationAssertion(oboInOwl:id obo:MONDO_0017936 "MONDO:0017936")
AnnotationAssertion(rdfs:label obo:MONDO_0017936 "benign Samaritan congenital myopathy")
AnnotationAssertion(skos:exactMatch obo:MONDO_0017936 <http://identifiers.org/medgen/1666762>)
AnnotationAssertion(skos:exactMatch obo:MONDO_0017936 <http://linkedlifedata.com/resource/umls/id/C4749502>)
