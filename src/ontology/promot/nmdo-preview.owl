AnnotationAssertion(oboInOwl:hasDbXref obo:HP_0000006 "UMLS:C0443147")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:HP_0000006 "Autosomal dominant")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType hp:allelic_requirement) oboInOwl:hasExactSynonym obo:HP_0000006 "monoallelic_autosomal")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref <https://orcid.org/0000-0002-5316-1399>) oboInOwl:hasRelatedSynonym obo:HP_0000006 "Autosomal dominant form")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref <https://orcid.org/0000-0002-5316-1399>) oboInOwl:hasRelatedSynonym obo:HP_0000006 "Autosomal dominant type")
