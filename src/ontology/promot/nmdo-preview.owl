# Class: obo:HP_0030828 (Wheezing)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref <https://orcid.org/0000-0002-0736-9199>) Annotation(oboInOwl:hasDbXref "PMID:26229557") obo:IAO_0000115 obo:HP_0030828 "A high-pitched whistling sound associated with labored breathing.")
AnnotationAssertion(oboInOwl:hasDbXref obo:HP_0030828 "SNOMEDCT_US:56018004")
AnnotationAssertion(oboInOwl:hasDbXref obo:HP_0030828 "UMLS:C0043144")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType hp:layperson) oboInOwl:hasExactSynonym obo:HP_0030828 "Wheezing")
AnnotationAssertion(rdfs:comment obo:HP_0030828 "Wheezes and rhonchi are continuous musical lung sounds. The American Thoracic Society (ATS) Committee on pulmonary nomenclature defines wheezes as high-pitched continuous sounds with a dominant frequency of 400 Hz or more, and rhonchi as low-pitched continuous musical sounds with a dominant frequency of about 200 Hz or less")
AnnotationAssertion(rdfs:label obo:HP_0030828 "Wheezing")
SubClassOf(obo:HP_0030828 obo:HP_0002795)

# Class: obo:HP_0031690 (Opportunistic infection)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref <https://orcid.org/0000-0002-0736-9199>) obo:IAO_0000115 obo:HP_0031690 "An infection that is caused by a pathogen that would generally not be able to cause an infection in a host with a normal immune system. Such pathogens take advantage of the opportunity, so to speak, that is provided by a weakened immune system.")
AnnotationAssertion(rdfs:comment obo:HP_0031690 "Opportunistic infection are infections that occur more often or are more severe in people with weakened immune systems than in those with normal immune system functioning.")
AnnotationAssertion(rdfs:label obo:HP_0031690 "Opportunistic infection")
SubClassOf(obo:HP_0031690 obo:HP_0010978)
SubClassOf(obo:HP_0031690 obo:MONDO_0045034)

