SubClassOf(obo:HP_0100022 obo:HP_0012638)

# Class: obo:HP_0100306 (Muscle fiber hyaline bodies)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PMID:16018165") obo:IAO_0000115 obo:HP_0100306 "Subsarcolemmal, eosinophilic glass-like regions in the cytoplasm of muscle fibers. Hyaline bodies show significant reactivity to myofibrillar ATPase after acid pre-incubation and with immunohistochemistry, show intense reactivity with only slow myosin heavy chain. Electron microscopy of the affected areas show a lack of myofibrils and a uniform, finely granular matrix, sometimes suggesting a filamentous nature, containing few scattered nuclei and mitochondria.")
AnnotationAssertion(oboInOwl:hasDbXref obo:HP_0100306 "UMLS:C4022155")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType hp:uk_spelling) oboInOwl:hasExactSynonym obo:HP_0100306 "Muscle fibre hyaline bodies")
AnnotationAssertion(oboInOwl:id obo:HP_0100306 "HP:0100306")
AnnotationAssertion(rdfs:label obo:HP_0100306 "Muscle fiber hyaline bodies")
SubClassOf(obo:HP_0100306 obo:HP_0011805)
SubClassOf(obo:HP_0100306 obo:HP_0025354)

