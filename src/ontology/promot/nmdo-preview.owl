AnnotationAssertion(obo:IAO_0000115 obo:RO_0002150 "X continuous_with Y if and only if X and Y share a fiat boundary.")
AnnotationAssertion(oboInOwl:hasDbXref obo:RO_0002150 "RO:0002150")
AnnotationAssertion(oboInOwl:id obo:RO_0002150 "continuous_with")
AnnotationAssertion(rdfs:label obo:RO_0002150 "continuous with")
AnnotationAssertion(rdfs:label obo:RO_0002150 "continuous with"@en)
