# Class: obo:HP_0001324 (Muscle weakness)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref <https://orcid.org/0000-0002-0736-9199>) Annotation(oboInOwl:hasDbXref "PMID:15832536") obo:IAO_0000115 obo:HP_0001324 "Reduced strength of muscles.")
AnnotationAssertion(oboInOwl:hasAlternativeId obo:HP_0001324 "HP:0002309")
AnnotationAssertion(oboInOwl:hasAlternativeId obo:HP_0001324 "HP:0008979")
AnnotationAssertion(oboInOwl:hasAlternativeId obo:HP_0001324 "HP:0009012")
AnnotationAssertion(oboInOwl:hasAlternativeId obo:HP_0001324 "HP:0009061")
AnnotationAssertion(oboInOwl:hasDbXref obo:HP_0001324 "SNOMEDCT_US:26544005")
AnnotationAssertion(oboInOwl:hasDbXref obo:HP_0001324 "UMLS:C0151786")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType hp:layperson) oboInOwl:hasExactSynonym obo:HP_0001324 "Muscle weakness")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType hp:layperson) oboInOwl:hasExactSynonym obo:HP_0001324 "Muscular weakness")
AnnotationAssertion(oboInOwl:id obo:HP_0001324 "HP:0001324")
AnnotationAssertion(rdfs:comment obo:HP_0001324 "It is important clinical to distinguish between muscle weakness, fatigue, and asthenia. Fatigue describes the inability to continue performing a task after multiple repetitions; in contrast, a patient with primary weakness is unable to perform the first repetition of the task. Asthenia is a sense of weariness or exhaustion in the absence of muscle weakness. Conditions that result in intrinsic muscle weakness can be divided into several main categories: infectious, neurologic, endocrine, inflammatory, rheumatologic, genetic, metabolic, electrolyte-induced, or drug-induced.")
AnnotationAssertion(rdfs:label obo:HP_0001324 "Muscle weakness")
SubClassOf(obo:HP_0001324 obo:HP_0011804)

# Class: obo:HP_0001336 (Myoclonus)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref <https://orcid.org/0000-0002-0736-9199>) Annotation(oboInOwl:hasDbXref "PMID:20589866") obo:IAO_0000115 obo:HP_0001336 "Very brief, involuntary random muscular contractions occurring at rest, in response to sensory stimuli, or accompanying voluntary movements.")
AnnotationAssertion(oboInOwl:hasAlternativeId obo:HP_0001336 "HP:0002535")
AnnotationAssertion(oboInOwl:hasAlternativeId obo:HP_0001336 "HP:0007087")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType hp:layperson) oboInOwl:hasBroadSynonym obo:HP_0001336 "Jerking")
AnnotationAssertion(oboInOwl:hasDbXref obo:HP_0001336 "SNOMEDCT_US:127324008")
AnnotationAssertion(oboInOwl:hasDbXref obo:HP_0001336 "SNOMEDCT_US:17450006")
AnnotationAssertion(oboInOwl:hasDbXref obo:HP_0001336 "UMLS:C0027066")
AnnotationAssertion(oboInOwl:hasDbXref obo:HP_0001336 "UMLS:C1854302")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:HP_0001336 "Myoclonic jerks")
AnnotationAssertion(oboInOwl:hasRelatedSynonym obo:HP_0001336 "Involuntary jerking movements")
AnnotationAssertion(oboInOwl:id obo:HP_0001336 "HP:0001336")
AnnotationAssertion(rdfs:comment obo:HP_0001336 "Myoclonus may be synchronous (several muscle contracting simultaneously), spreading (several muscles contracting in sequence), or asynchronous (several muscles contracting with varying and unpredictable relative timing). Myoclonus is characterized by sudden unidirectional movement due to muscle contraction (positive myoclonus) or due to sudden brief muscle relaxation (negative myoclonus). Electrophysiological tests are very helpful in determining whether myoclonus is cortical, subcortical or spinal.")
AnnotationAssertion(rdfs:label obo:HP_0001336 "Myoclonus")
SubClassOf(obo:HP_0001336 obo:HP_0004305)

# Class: obo:HP_0001339 (Lissencephaly)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref <http://www.wikidata.org/entity/Q90573458>) Annotation(oboInOwl:hasDbXref <https://orcid.org/0000-0002-0736-9199>) Annotation(oboInOwl:hasDbXref "PMID:28440899") obo:IAO_0000115 obo:HP_0001339 "A spectrum of malformations of cortical development caused by insufficient neuronal migration that subsumes the terms agyria, pachygyria and subcortical band heterotopia. See also neuropathological definitions for 2-, 3-, and 4-layered lissencephaly.")
AnnotationAssertion(oboInOwl:hasAlternativeId obo:HP_0001339 "HP:0002537")
AnnotationAssertion(oboInOwl:hasDbXref obo:HP_0001339 "SNOMEDCT_US:204036008")
AnnotationAssertion(oboInOwl:hasDbXref obo:HP_0001339 "UMLS:C0266463")
AnnotationAssertion(oboInOwl:hasDbXref obo:HP_0001339 "UMLS:C1879312")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref <https://orcid.org/0000-0001-5208-3432>) Annotation(oboInOwl:hasDbXref <https://orcid.org/0000-0002-6548-5200>) Annotation(oboInOwl:hasSynonymType hp:layperson) oboInOwl:hasExactSynonym obo:HP_0001339 "Fewer or absent grooves in brain")
AnnotationAssertion(oboInOwl:id obo:HP_0001339 "HP:0001339")
AnnotationAssertion(rdfs:comment obo:HP_0001339 "Lissencephaly (LIS, which subsumes the terms agyria and pachygyria), together with subcortical-band heterotopia (SBH) comprises a spectrum of malformations of cortical development caused by insufficient neuronal migration. The key features of LIS are an abnormally thick cortex with reduced or absent formation of the cerebral convolutions, while SBH consists of abnormal bands of neurons beneath a normal cortex, although the cerebral gyri may be separated by unusually shallow sulci.")
AnnotationAssertion(rdfs:label obo:HP_0001339 "Lissencephaly")
SubClassOf(obo:HP_0001339 obo:HP_0002060)

