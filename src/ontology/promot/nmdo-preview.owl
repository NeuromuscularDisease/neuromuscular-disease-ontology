AnnotationAssertion(oboInOwl:id obo:HP_0002047 "HP:0002047")
AnnotationAssertion(rdfs:label obo:HP_0002047 "Malignant hyperthermia")
SubClassOf(obo:HP_0002047 obo:HP_0012337)

