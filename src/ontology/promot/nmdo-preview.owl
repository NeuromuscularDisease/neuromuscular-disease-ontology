AnnotationAssertion(oboInOwl:hasDbXref obo:HP_0012759 "UMLS:C4022737")
AnnotationAssertion(oboInOwl:id obo:HP_0012759 "HP:0012759")
AnnotationAssertion(rdfs:comment obo:HP_0012759 "This term should be used to describe abnormalities with onset in the developmental period.")
AnnotationAssertion(rdfs:label obo:HP_0012759 "Neurodevelopmental abnormality")
SubClassOf(obo:HP_0012759 obo:HP_0012638)

# Class: obo:HP_0012823 (Clinical modifier)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref <https://orcid.org/0000-0002-0736-9199>) obo:IAO_0000115 obo:HP_0012823 "This subontology is designed to provide terms to characterize and specify the phenotypic abnormalities defined in the Phenotypic abnormality subontology, with respect to severity, laterality, age of onset, and other aspects.")
AnnotationAssertion(oboInOwl:hasAlternativeId obo:HP_0012823 "HP:0000004")
AnnotationAssertion(oboInOwl:hasDbXref obo:HP_0012823 "UMLS:C4021064")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:HP_0012823 "Phenotypic modifier")
AnnotationAssertion(oboInOwl:id obo:HP_0012823 "HP:0012823")
AnnotationAssertion(rdfs:comment obo:HP_0012823 "Note that some of the terms, such as Intellectual disability, have children terms such as Severe intellectual disability that represent precomposed combinations of modifiers and phenotypic abnormality terms. This done where the medical community commonly uses these terms with a fixed meaning (for instance, the Intellectual disability terms are used with specific IQ ranges). For computational reasoning, the semantics are intended to be the same as if there was a combination of the phenotype term and the clinical modifier term.")
AnnotationAssertion(rdfs:label obo:HP_0012823 "Clinical modifier")
SubClassOf(obo:HP_0012823 obo:PATO_0000001)

