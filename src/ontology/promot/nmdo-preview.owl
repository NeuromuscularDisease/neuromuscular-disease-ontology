AnnotationAssertion(Annotation(oboInOwl:source "MONDO:MEDGEN") Annotation(oboInOwl:source "MONDO:equivalentTo") oboInOwl:hasDbXref obo:MONDO_0019550 "MEDGEN:1669448")
