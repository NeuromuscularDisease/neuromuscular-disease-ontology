AnnotationAssertion(Annotation(oboInOwl:hasDbXref "Orphanet:329336") oboInOwl:hasExactSynonym obo:MONDO_0018002 "adult-onset CPEO with mitochondrial myopathy")
AnnotationAssertion(oboInOwl:id obo:MONDO_0018002 "MONDO:0018002")
