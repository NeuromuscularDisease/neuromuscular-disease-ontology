AnnotationAssertion(Annotation(oboInOwl:hasDbXref "Orphanet:90118") oboInOwl:hasExactSynonym obo:MONDO_0019549 "SEOAN due to MFN2 deficiency")
AnnotationAssertion(Annotation(oboInOwl:hasDbXref "Orphanet:90118") oboInOwl:hasExactSynonym obo:MONDO_0019549 "autosomal recessive Charcot-Marie-Tooth disease, Ouvrier type")
