AnnotationAssertion(terms:description <https://www.genenames.org/data/genegroup/#!/group/1083> "The HAD phosphatase family are named after the bacterial enzyme haloacid dehydrogenase and employ an Asp-based catalytic mechanism. The family includes both protein and non-protein phosphatases.")
AnnotationAssertion(rdfs:label <https://www.genenames.org/data/genegroup/#!/group/1083> "HAD Asp-based phosphatases")
SubClassOf(<https://www.genenames.org/data/genegroup/#!/group/1083> <https://www.genenames.org/data/genegroup/#!/group/1076>)

