AnnotationAssertion(Annotation(oboInOwl:hasDbXref "Orphanet:90103") oboInOwl:hasExactSynonym obo:MONDO_0008960 "hereditary motor and sensory neuropathy with deafness, intellectual disability and absent sensory large myelinated fibers")
