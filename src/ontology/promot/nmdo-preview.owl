SubClassOf(obo:HP_0025354 obo:HP_0000118)

# Class: obo:HP_0030051 (Tip-toe gait)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "PMID:24757457") Annotation(oboInOwl:hasDbXref "PMID:26709689") obo:IAO_0000115 obo:HP_0030051 "An abnormal gait pattern characterized by the failure of the heel to contact the floor at the onset of stance during gait.")
AnnotationAssertion(oboInOwl:hasAlternativeId obo:HP_0030051 "HP:0002394")
AnnotationAssertion(oboInOwl:hasAlternativeId obo:HP_0030051 "HP:0040083")
AnnotationAssertion(oboInOwl:hasDbXref obo:HP_0030051 "UMLS:C1843570")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:HP_0030051 "Tiptoe gait")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType hp:layperson) oboInOwl:hasExactSynonym obo:HP_0030051 "Toe walking")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType hp:layperson) oboInOwl:hasExactSynonym obo:HP_0030051 "Walking on tiptoes")
AnnotationAssertion(rdfs:comment obo:HP_0030051 "Tip-toe walking (or simply toe-walking) is common in healthy young children, and should resolve spontaneously by 3 years of age. After this age, tip-toe gait must be differentiated from habitual toe gait, congenital short tendo calcaneus, cerebral palsy, syringomyelia, spinal tumor, hematoma in a lower limb muscle, or neuromuscular diseases like muscular dystrophy, Charcot-Marie-Tooth disease and hereditary sensorimotor neuropathies. If the toe gait persists for 2-3 years, this gait pattern is not considered to be habitual. Therefore, the judgment of habitual toe gait should not be determined without evaluation for other diseases.")
AnnotationAssertion(rdfs:label obo:HP_0030051 "Tip-toe gait")
SubClassOf(obo:HP_0030051 obo:HP_0001288)

