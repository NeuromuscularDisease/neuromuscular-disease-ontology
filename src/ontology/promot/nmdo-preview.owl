# Class: obo:HP_0012735 (Cough)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref <https://orcid.org/0000-0002-0736-9199>) Annotation(oboInOwl:hasDbXref "PMID:16428719") Annotation(oboInOwl:hasDbXref "PMID:17540788") obo:IAO_0000115 obo:HP_0012735 "A sudden, audible expulsion of air from the lungs through a partially closed glottis, preceded by inhalation.")
AnnotationAssertion(oboInOwl:hasDbXref obo:HP_0012735 "SNOMEDCT_US:263731006")
AnnotationAssertion(oboInOwl:hasDbXref obo:HP_0012735 "SNOMEDCT_US:272039006")
AnnotationAssertion(oboInOwl:hasDbXref obo:HP_0012735 "SNOMEDCT_US:49727002")
AnnotationAssertion(oboInOwl:hasDbXref obo:HP_0012735 "UMLS:C0010200")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType hp:layperson) oboInOwl:hasExactSynonym obo:HP_0012735 "Cough")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType hp:layperson) oboInOwl:hasExactSynonym obo:HP_0012735 "Coughing")
AnnotationAssertion(oboInOwl:id obo:HP_0012735 "HP:0012735")
AnnotationAssertion(rdfs:comment obo:HP_0012735 "The European Respiratory Society Task Force recommended two possible definitions of cough: (1) A three-phase expulsive motor act characterized by an inspiratory effort (inspiratory phase) followed by a forced expiratory effort against a closed glottis (compressive phase) and then by opening of the glottis and rapid expiratory airflow (expulsive phase);and (2) A forced expiratory maneuver, usually against a closed glottis and associated with a characteristic sound. The term Cough or any of its more specific descendents can be modified by the terms Acute (HP:0011009), Subacute (HP:0011011), and Chronic (HP:0011010). In adults, an acute cough lasts less than 3 weeks, a subacute cough from 3 to 8 weeks, and a chronic cough longer than 8 weeks. In children aged less than 15 years a chronic cough is defined as a daily cough lasting for over 4 weeks.")
AnnotationAssertion(rdfs:label obo:HP_0012735 "Cough")
SubClassOf(obo:HP_0012735 obo:HP_0002795)

# Class: obo:HP_0012759 (Neurodevelopmental abnormality)

