# Class: obo:MONDO_0017933 (hypertrophic cardiomyopathy and renal tubular disease due to mitochondrial DNA mutation)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "Orphanet:324525") obo:IAO_0000115 obo:MONDO_0017933 "Hypertrophic cardiomyopathy and renal tubular disease due to mitochondrial DNA mutation is a mitochondrial oxidative phosphorylation disorder characterized by hypertrophic and dilated cardiomyopathy, failure to thrive, myopathy with generalized hypotonia and increased creatine kinase, developmental delay and/or regression with cerebral atrophy on brain MRI, renal manifestations including chronic renal failure, renal tubular acidosis and lactic acidosis. Additional clinical features include seizures and respiratory failure.")
AnnotationAssertion(Annotation(oboInOwl:source "MONDO:GARD") oboInOwl:hasDbXref obo:MONDO_0017933 "GARD:0021442")
AnnotationAssertion(Annotation(oboInOwl:source "MONDO:MEDGEN") Annotation(oboInOwl:source "MONDO:equivalentTo") oboInOwl:hasDbXref obo:MONDO_0017933 "MEDGEN:1650300")
AnnotationAssertion(Annotation(oboInOwl:source "MONDO:equivalentTo") oboInOwl:hasDbXref obo:MONDO_0017933 "Orphanet:324525")
AnnotationAssertion(Annotation(oboInOwl:source "MEDGEN:1650300") Annotation(oboInOwl:source "MONDO:MEDGEN") Annotation(oboInOwl:source "MONDO:equivalentTo") oboInOwl:hasDbXref obo:MONDO_0017933 "UMLS:C4749942")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:MONDO_0017933 "hypertrophic cardiomyopathy and renal tubular disease due to mtDNA mutation")
AnnotationAssertion(oboInOwl:id obo:MONDO_0017933 "MONDO:0017933")
AnnotationAssertion(rdfs:label obo:MONDO_0017933 "hypertrophic cardiomyopathy and renal tubular disease due to mitochondrial DNA mutation")
AnnotationAssertion(skos:exactMatch obo:MONDO_0017933 <http://identifiers.org/medgen/1650300>)
AnnotationAssertion(skos:exactMatch obo:MONDO_0017933 <http://linkedlifedata.com/resource/umls/id/C4749942>)
AnnotationAssertion(skos:exactMatch obo:MONDO_0017933 <http://www.orpha.net/ORDO/Orphanet_324525>)
SubClassOf(Annotation(oboInOwl:source "https://orcid.org/0000-0001-5208-3432") obo:MONDO_0017933 obo:MONDO_0016387)
SubClassOf(obo:MONDO_0017933 ObjectSomeValuesFrom(obo:RO_0000053 obo:SO_1000008))

# Class: obo:MONDO_0017936 (benign Samaritan congenital myopathy)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "Orphanet:324581") obo:IAO_0000115 obo:MONDO_0017936 "Benign Samaritan congenital myopathy is a rare, genetic, skeletal muscle disease characterized by severe neonatal hypotonia with respiratory insufficiency, delay in motor milestones, and dysmorphic features including bitemporal narrowing, epicanthal folds and hypertelorism. Affected individuals show gradual improvement in hypotonia and muscle weakness within the first two years of life resulting in minimal clinical manifestations in adulthood.")
AnnotationAssertion(Annotation(oboInOwl:source "MONDO:GARD") oboInOwl:hasDbXref obo:MONDO_0017936 "GARD:0021445")
AnnotationAssertion(Annotation(oboInOwl:source "MONDO:MEDGEN") Annotation(oboInOwl:source "MONDO:equivalentTo") oboInOwl:hasDbXref obo:MONDO_0017936 "MEDGEN:1666762")
