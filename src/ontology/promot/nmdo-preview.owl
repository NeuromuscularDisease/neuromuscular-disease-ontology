AnnotationAssertion(Annotation(oboInOwl:source "MEDGEN:1647450") Annotation(oboInOwl:source "MONDO:MEDGEN") Annotation(oboInOwl:source "MONDO:equivalentTo") oboInOwl:hasDbXref obo:MONDO_0017892 "UMLS:C4707155")
