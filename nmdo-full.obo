synonym: "TPR" RELATED []
synonym: "TTC" RELATED OMO:0003000 []
is_a: SO:0005855 ! gene group

[Term]
id: https://www.genenames.org/data/genegroup/#!/group/772
name: Trafficking protein particle complex subunits
synonym: "Transport protein particle complex" RELATED []
synonym: "TRAPP complex" RELATED []
synonym: "TRAPPC" RELATED OMO:0003000 []
is_a: SO:0005855 ! gene group

[Term]
id: https://www.genenames.org/data/genegroup/#!/group/777
name: Tropomyosins
synonym: "TPM" RELATED OMO:0003000 []
is_a: SO:0005855 ! gene group
property_value: terms:description "Tropomyosins are a large family of integral components of actin filaments that play a critical role in regulating the function of actin filaments in both muscle and nonmuscle cells. These proteins consist of rod-shaped coiled-coil hetero- or homo-dimers that lie along the α-helical groove of most actin filaments. Interaction occurs along the length of the actin filament, with dimers aligning in a head-to-tail fashion." xsd:string

