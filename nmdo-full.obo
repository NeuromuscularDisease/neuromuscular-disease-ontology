synonym: "spinal muscular atrophy, X-linked type 2" EXACT []
synonym: "X-linked distal arthrogryposis multiplex congenita" EXACT [DOID:0111827, Orphanet:1145]
synonym: "X-linked spinal muscular atrophy type 2" EXACT [DOID:0111827, Orphanet:1145]
