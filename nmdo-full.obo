is_a: MONDO:0017303 {source="https://clinicalgenome.org/affiliation/40031/"} ! neuromuscular disease caused by qualitative or quantitative defects of tropomyosin
is_a: MONDO:0019952 {source="https://clinicalgenome.org/affiliation/40031/"} ! congenital myopathy
is_a: MONDO:0100545 ! hereditary neurological disease
intersection_of: MONDO:0019952 ! congenital myopathy
