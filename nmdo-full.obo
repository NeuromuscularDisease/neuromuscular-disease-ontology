synonym: "CMTRIA" EXACT ABBREVIATION [DOID:0110201, OMIM:608340]
synonym: "GDAP1 Charcot-Marie-Tooth disease" EXACT [MONDO:design_pattern, MONDO:patterns/disease_series_by_gene]
