synonym: "muscular dystrophy, limb-girdle, autosomal recessive 10" EXACT [OMIM:608807]
synonym: "muscular dystrophy, limb-girdle, type 2J" EXACT [DOID:0110283, OMIM:608807]
synonym: "TTN autosomal recessive limb-girdle muscular dystrophy" EXACT [MONDO:design_pattern, MONDO:patterns/disease_series_by_gene]
