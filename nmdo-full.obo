is_a: MONDO:0016191 {source="https://orcid.org/0000-0002-6601-2165"} ! neuromuscular disease caused by qualitative or quantitative defects of titin
is_a: MONDO:0019952 {source="https://clinicalgenome.org/affiliation/40031/"} ! congenital myopathy
is_a: MONDO:0100545 ! hereditary neurological disease
intersection_of: MONDO:0019952 {source="https://clinicalgenome.org/affiliation/40031/"} ! congenital myopathy
