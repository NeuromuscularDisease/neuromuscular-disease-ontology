is_a: https://www.genenames.org/data/genegroup/#!/group/516 ! Homeoboxes

[Term]
id: https://www.genenames.org/data/genegroup/#!/group/535
name: DNA polymerases
synonym: "DNA-directed DNA polymerases" RELATED []
synonym: "POL" RELATED OMO:0003000 []
synonym: "Polymerases, DNA directed" RELATED []
is_a: SO:0005855 ! gene group
property_value: terms:description "Enzyme that catalyzes DNA synthesis by addition of deoxyribonucleotide units to a DNA chain using DNA as a template. They can also possess exonuclease activity and therefore function in DNA repair." xsd:string

[Term]
id: https://www.genenames.org/data/genegroup/#!/group/539
