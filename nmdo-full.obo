name: DENN domain containing
synonym: "DENN/MADD domain containing" RELATED []
synonym: "DENND" RELATED OMO:0003000 []
is_a: SO:0005855 ! gene group

[Term]
id: https://www.genenames.org/data/genegroup/#!/group/516
name: Homeoboxes
synonym: "Homeodomain containing" RELATED []
is_a: SO:0005855 ! gene group
property_value: terms:description "Protein which contains at least one homeobox, a conserved sequence originally detected, on the nucleotide level, in many of the genes which give rise to homeotic and segmentation mutants in Drosophila. The homeobox, also termed homeodomain, consists of about 60 amino acids and is involved in DNA-binding." xsd:string

[Term]
id: https://www.genenames.org/data/genegroup/#!/group/521
