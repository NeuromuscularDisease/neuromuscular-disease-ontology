synonym: "ITGA7 congenital muscular dystrophy" EXACT [MONDO:design_pattern, MONDO:patterns/disease_series_by_gene]
synonym: "muscular dystrophy, congenital, due to ITGA7 deficiency" RELATED [GARD:0012587]
